        ctaIds.forEach(function(id) {
          var el = document.getElementById(id);
          if (el) {
            el.addEventListener('click', function() {
              if (typeof fbq !== 'undefined') {
                fbq('track', 'Lead', { content_name: 'mercadolibre-' + id });
              }
            });
          }
        });
      });
