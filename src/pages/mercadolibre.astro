---
import "@fontsource-variable/inter";
import "~/styles/index.css";

const title       = "Vendes en MercadoLibre — Tu marca todavía no existe · JERG.STUDIO";
const description = "Llevas años vendiendo en ML. Pero tus clientes recuerdan la plataforma, no a ti. Construimos tu tienda, tu catálogo y tus automatizaciones. Precio fijo, 11 días.";
const siteUrl     = "https://jerg.studio/mercadolibre";
const waText      = encodeURIComponent("Hola, vendo en MercadoLibre y quiero hablar sobre mis opciones");
const waUrl       = `https://wa.me/56967657198?text=${waText}`;

const features = [
  {
    num: "01",
    title: "Una tienda que no depende de nadie más que tú",
    desc: "Tu dominio, tu marca, tu canal directo. Si ML cambia las reglas mañana, tu negocio sigue en pie.",
  },
  {
    num: "02",
    title: "Tus clientes te escriben a ti, no a la plataforma",
    desc: "Un catálogo en tu propio dominio. Tus compradores ven todo y te contactan directo por WhatsApp — sin intermediarios.",
  },
  {
    num: "03",
    title: "El mismo inventario en los dos canales, sin fricción",
    desc: "Cuando alguien compra en uno, el otro se actualiza solo. Sin errores de stock, sin ventas duplicadas.",
  },
  {
    num: "04",
    title: '"¿Hacen envíos a…?" — respondido antes de que llegues',
    desc: "Las preguntas repetidas se contestan automáticamente. Solo atiendes lo que requiere tu criterio.",
  },
];

const quotes = [
  { text: "Honestamente no creía que iba a funcionar. El primer mensaje que me llegó por WhatsApp de un cliente nuevo me acuerdo perfectamente.", name: "Rodrigo M.", role: "Herramientas · Santiago" },
  { text: "Lo más raro fue que clientes que me habían comprado hace dos años me empezaron a escribir. No sabía que los tenía.", name: "Valentina C.", role: "Ropa · Buenos Aires" },
  { text: "En diciembre ML me suspendió la cuenta 3 días. Con mi tienda esos 3 días vendí igual.", name: "Felipe A.", role: "Electrónica · Caracas" },
  { text: "Mandé el catálogo a un grupo de WhatsApp con clientes viejos. Me respondieron ese mismo día.", name: "Carla R.", role: "Cosméticos · Bogotá" },
  { text: "Los primeros 15 días pensé que no valía la pena. Al mes siguiente ya no me imaginaba sin la tienda.", name: "Marcos D.", role: "Ferretería · Córdoba" },
  { text: "Ahora cuando alguien pregunta por algo que no tengo, le mando el catálogo completo. Antes no podía hacer eso.", name: "Sandra P.", role: "Ropa deportiva · Lima" },
];
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved ?? (prefersDark ? 'dark' : 'light'));
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={siteUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:image"       content="https://jerg.studio/social.jpg" />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:title"      content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"      content="https://jerg.studio/social.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <!-- META PIXEL -->
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init','YOUR_PIXEL_ID');fbq('track','PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=YOUR_PIXEL_ID&ev=PageView&noscript=1" alt="" /></noscript>
  </head>

  <body class="overflow-x-hidden">

    <div id="grain-overlay" aria-hidden="true"></div>

    <!-- NAV -->
    <nav class="p-nav" aria-label="Navegación principal">
      <a href="/" class="p-nav-logo" aria-label="JERG.STUDIO inicio">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="url(#nlg)"/>
          <path d="M8 12L14 16L8 20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M16 20H24" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
          <defs>
            <linearGradient id="nlg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop stop-color="#10b981"/><stop offset="1" stop-color="#34d399"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="p-nav-word">JERG<span style="color:#10b981">.</span>STUDIO</span>
      </a>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" class="p-nav-cta" id="nav-cta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Hablar ahora
      </a>
    </nav>

    <main>

      <!-- ═══════ HERO ═══════ -->
      <section class="hero" aria-labelledby="hero-h1">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-bg-text" aria-hidden="true">ML</div>

        <div class="hero-inner">
          <div class="hero-badge fade-in">
            <svg width="14" height="14" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <ellipse cx="24" cy="24" rx="22" ry="22" fill="#FFE600"/>
              <path d="M12 30V20l6 7 6-7v10M30 30V20l4 5 4-5v10" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Para vendedores de MercadoLibre que construyen en serio
          </div>

          <h1 id="hero-h1" class="hero-title fade-in">
            Vendes bien en ML.<br/>
            <em>Tu marca no existe todavía.</em>
          </h1>

          <p class="hero-sub fade-in">
            Llevas años vendiendo. Pero tus clientes recuerdan a MercadoLibre,<br/>
            no a ti. Eso tiene solución.
          </p>

          <!-- Estado de cuenta -->
          <div class="statement fade-in" role="img" aria-label="Estado de cuenta mostrando comisiones de MercadoLibre">
            <div class="stmt-header">
              <span class="stmt-entity">Estado de cuenta · Vendedor ML</span>
              <span class="stmt-period">Ene – Dic 2024</span>
            </div>
            <div class="stmt-row">
              <span>Ventas brutas del año</span>
              <span>$800.000</span>
            </div>
            <div class="stmt-row stmt-row--debit">
              <span>Comisiones cobradas por ML</span>
              <span class="stmt-debit">− $176.000</span>
            </div>
            <div class="stmt-divider"></div>
            <div class="stmt-row stmt-row--net">
              <span>Lo que recibiste</span>
              <span>$624.000</span>
            </div>
            <div class="stmt-row stmt-row--potential">
              <span>Con tu tienda propia</span>
              <span class="stmt-credit">$800.000</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="hero-ctas fade-in">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="cta-primary" id="hero-cta">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Construye tu marca hoy
            </a>
            <span class="hero-hint">Precio fijo · Sin contratos · Entrega en 11 días</span>
          </div>
        </div>

        <div class="hero-scroll" aria-hidden="true">
          <span class="hero-scroll-line"></span>
        </div>
      </section>

      <!-- ═══════ TRANSFORMACIÓN ═══════ -->
      <section class="transform" aria-labelledby="transform-h2">
        <div class="section-wrap">
          <div class="section-eyebrow fade-up">El contraste</div>
          <h2 id="transform-h2" class="section-title fade-up">
            El mismo producto.<br/>
            <em>Dos identidades completamente distintas.</em>
          </h2>

          <div class="screens fade-up">
            <!-- Lado ML: perdido entre cientos -->
            <div class="screen screen--ml">
              <div class="screen-bar">
                <div class="screen-dots"><span></span><span></span><span></span></div>
                <div class="screen-url">mercadolibre.com · resultados de búsqueda</div>
              </div>
              <div class="screen-body screen-body--search">
                <div class="srp-header">
                  <span class="srp-count">1.847 resultados</span>
                  <span class="srp-sort">Más relevantes ↓</span>
                </div>
                <div class="srp-list">
                  <div class="srp-item srp-item--hl">
                    <div class="srp-thumb srp-thumb--blue"></div>
                    <div class="srp-info">
                      <span class="srp-name">Tu producto · $89.900</span>
                      <span class="srp-seller">vendedor_23847 · 234 ventas</span>
                      <span class="srp-tag">Envío estándar</span>
                    </div>
                  </div>
                  <div class="srp-item srp-item--dim">
                    <div class="srp-thumb srp-thumb--gray"></div>
                    <div class="srp-info">
                      <span class="srp-name">Producto similar · $88.200</span>
                      <span class="srp-seller">tienda_herramientas · 1.203 ventas</span>
                    </div>
                  </div>
                  <div class="srp-item srp-item--dim">
                    <div class="srp-thumb srp-thumb--gray"></div>
                    <div class="srp-info">
                      <span class="srp-name">Producto similar · $91.000</span>
                      <span class="srp-seller">ferreteria_online22 · 87 ventas</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="screen-label screen-label--bad">Hoy · Eres uno de 1.847</div>
            </div>

            <div class="screens-vs" aria-hidden="true">→</div>

            <!-- Lado propio: marca reconocible -->
            <div class="screen screen--yours">
              <div class="screen-bar">
                <div class="screen-dots screen-dots--yellow"><span></span><span></span><span></span></div>
                <div class="screen-url screen-url--yours">ferreteria-martinez.cl</div>
              </div>
              <div class="screen-body screen-body--brand">
                <!-- Google result card -->
                <div class="gcard">
                  <div class="gcard-source">
                    <div class="gcard-favicon"></div>
                    <div>
                      <div class="gcard-domain">ferreteria-martinez.cl</div>
                      <div class="gcard-crumb">Inicio</div>
                    </div>
                  </div>
                  <div class="gcard-title">Ferretería Martínez | Herramientas y equipos</div>
                  <div class="gcard-desc">Más de 300 productos. Envíos a todo el país. Escríbenos directo por WhatsApp — respondemos el mismo día.</div>
                  <div class="gcard-stars">⭐ 4.9 · 47 reseñas</div>
                </div>
                <!-- WhatsApp button -->
                <div class="brand-wa">
                  <div class="brand-wa-dot"></div>
                  <span>Martínez en línea · WhatsApp</span>
                  <span class="brand-wa-arrow">→</span>
                </div>
              </div>
              <div class="screen-label screen-label--good">Con tu tienda · Te buscan a ti</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════ FEATURES ═══════ -->
      <section class="features" aria-labelledby="features-h2">
        <div class="section-wrap">
          <div class="section-eyebrow fade-up">Lo que construimos</div>
          <h2 id="features-h2" class="section-title fade-up">
            Cuatro herramientas.<br/>
            <em>Una independencia real.</em>
          </h2>
          <ul class="feat-list" role="list">
            {features.map(({ num, title, desc }) => (
              <li class="feat-item fade-up">
                <span class="feat-num">{num}</span>
                <div class="feat-body">
                  <h3 class="feat-title">{title}</h3>
                  <p class="feat-desc">{desc}</p>
                </div>
                <div class="feat-line" aria-hidden="true"></div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ═══════ MARQUEE ═══════ -->
      <section class="marquee-section" aria-label="Testimonios de vendedores">
        <div class="marquee-eyebrow fade-up">Vendedores que ya construyeron su marca</div>
        <div class="marquee-wrap" aria-hidden="true">
          <!-- Fila 1: izquierda -->
          <div class="marquee-row">
            <div class="marquee-track">
              {[...quotes, ...quotes].map(({ text, name, role }) => (
                <div class="marquee-item">
                  <p class="marquee-text">"{text}"</p>
                  <span class="marquee-author">{name} · <em>{role}</em></span>
                </div>
              ))}
            </div>
          </div>
          <!-- Fila 2: derecha -->
          <div class="marquee-row marquee-row--reverse">
            <div class="marquee-track marquee-track--reverse">
              {[...quotes.slice(3), ...quotes.slice(0,3), ...quotes.slice(3), ...quotes.slice(0,3)].map(({ text, name, role }) => (
                <div class="marquee-item">
                  <p class="marquee-text">"{text}"</p>
                  <span class="marquee-author">{name} · <em>{role}</em></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════ YELLOW FINALE ═══════ -->
      <section class="finale" aria-labelledby="finale-h2">
        <div class="finale-inner">
          <div class="finale-eyebrow">La realidad</div>
          <h2 id="finale-h2" class="finale-title">
            Tu negocio<br/>crece.<br/><em>Tu marca, todavía no.</em>
          </h2>
          <p class="finale-sub">
            Cuéntanos cómo funciona tu negocio hoy.<br/>
            En 10 minutos te decimos exactamente por dónde empezar.
          </p>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="finale-cta" id="footer-cta">
            Construye tu marca →
          </a>
          <p class="finale-note">
            O escribinos al
            <a href={waUrl} target="_blank" rel="noopener noreferrer">+56 9 6765 7198</a>
            ·
            <a href="mailto:Jerg.studio@gmail.com">Jerg.studio@gmail.com</a>
          </p>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="p-footer">
      <div class="p-footer-inner">
        <a href="/" class="p-footer-logo">JERG<span style="color:#10b981">.</span>STUDIO</a>
        <div class="p-footer-links">
          <a href="/privacidad">Privacidad</a>
          <a href="/terminos">Términos</a>
          <a href="/">Inicio</a>
        </div>
        <p class="p-footer-copy">© {new Date().getFullYear()} JERG.STUDIO</p>
      </div>
    </footer>

    <!-- WhatsApp FAB -->
    <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" class="wa-fab" id="wa-fab">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="wa-fab-label">¿Hablamos?</span>
    </a>

    <!-- Fade-up observer -->
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.fade-in').forEach(el => el.classList.add('visible'));
      if (!reduced) {
        const io = new IntersectionObserver(
          entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } }),
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
      } else {
        document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));
      }
    </script>

    <!-- Pixel: Lead en CTAs -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        ['hero-cta','footer-cta','wa-fab','nav-cta'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) el.addEventListener('click', function() {
            if (typeof fbq !== 'undefined') fbq('track','Lead',{content_name:'ml-'+id});
          });
        });
      });
    </script>

  </body>
</html>

<style>
  /* ── Base ── */
  body { background: #070707; color: #f5f0e8; font-family: 'Inter Variable', system-ui, sans-serif; }

  #grain-overlay {
    position: fixed; inset: 0; pointer-events: none; z-index: 9990; opacity: 0.028;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px; animation: grain 0.8s steps(1) infinite;
  }
  @keyframes grain {
    0%  {background-position:0% 0%}  14% {background-position:-18% -22%}
    28% {background-position:22% 12%} 42% {background-position:-6% 32%}
    57% {background-position:16% -18%} 71% {background-position:-24% 22%}
