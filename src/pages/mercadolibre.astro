---
import "@fontsource-variable/inter";
import "~/styles/index.css";

const title       = "Vendés en MercadoLibre — Construí lo que es tuyo con JERG.STUDIO";
const description = "Tienda propia que nadie te puede pausar, catálogo directo en WhatsApp, stock sincronizado y respuestas automáticas a las preguntas de ML. Precio fijo, entrega en 11 días.";
const siteUrl     = "https://jerg.studio/mercadolibre";
const waText      = encodeURIComponent("Hola, vendo en MercadoLibre y quiero hablar sobre mis opciones");
const waUrl       = `https://wa.me/56967657198?text=${waText}`;

const iconLock   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
const iconWa     = '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';
const iconSync   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>';
const iconBot    = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><path d="M13 8l-2 4h4l-2 4"/></svg>';

const services = [
  {
    iconColor: "yellow",
    icon: iconLock,
    title: "Una tienda que nadie te puede pausar",
    desc: "Tu dominio, tu marca, tus reglas. Cuando alguien te compra ahí, ese cliente es tuyo para siempre — no de ML.",
  },
  {
    iconColor: "green",
    icon: iconWa,
    title: "Las preguntas van directo a tu WhatsApp",
    desc: "Tus compradores habituales ya tienen tu número. Ahora pueden ver todo tu catálogo y pedirte sin abrir ML, sin esperar días.",
  },
  {
    iconColor: "blue",
    icon: iconSync,
    title: "El mismo stock en los dos lados, siempre",
    desc: "Cuando alguien compra en uno, el otro se actualiza solo. Nunca más vender lo mismo dos veces.",
  },
  {
    iconColor: "purple",
    icon: iconBot,
    title: '"¿Hacen envíos a…?" — se responde solo',
    desc: "Las preguntas repetidas de ML se contestan automáticamente. Vos solo atendés las que necesitan tu criterio.",
  },
];

const testimonials = [
  {
    quote: "Antes vendía solo en ML y pagaba comisión en cada venta. Ahora tengo mi tienda y el 40% de mis ventas llega directo por WhatsApp.",
    name: "Rodrigo M.",
    role: "Vendedor Platinum · Electrónica",
  },
  {
    quote: "En dos semanas ya tenía el catálogo andando. Mis clientes me preguntan ahí y les respondo desde el mismo WhatsApp Business.",
    name: "Valentina C.",
    role: "Vendedora · Ropa y accesorios",
  },
  {
    quote: "El inventario sincronizado me salvó de vender lo mismo dos veces. Era mi peor pesadilla y ahora no pienso más en eso.",
    name: "Felipe A.",
    role: "Vendedor · Herramientas y ferretería",
  },
];
---

<!doctype html>
<html lang="es" data-theme="dark" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Anti-flash tema -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved ?? (prefersDark ? 'dark' : 'light'));
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={siteUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:image"        content="https://jerg.studio/social.jpg" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content="https://jerg.studio/social.jpg" />


    <!-- ═══════════════════════════════════════════════
         META PIXEL — reemplazar YOUR_PIXEL_ID
         con el ID real cuando lo tengas
    ════════════════════════════════════════════════ -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', 'YOUR_PIXEL_ID');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=YOUR_PIXEL_ID&ev=PageView&noscript=1" alt="" />
    </noscript>
    <!-- ═══════════════════════════════════════════════ -->
  </head>

  <body class="overflow-x-hidden bg-default text-default text-base">

    <!-- Grano animado -->
    <div id="grain-overlay" aria-hidden="true"></div>

    <!-- ── Navbar mínimo — solo logo + volver ── -->
    <nav class="ml-nav" aria-label="Navegación principal">
      <a href="/" class="ml-nav-logo" aria-label="Ir al inicio de JERG.STUDIO">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="url(#nlg)"/>
          <path d="M8 12L14 16L8 20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M16 20H24" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
          <defs>
            <linearGradient id="nlg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop stop-color="#10b981"/><stop offset="1" stop-color="#34d399"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="ml-nav-wordmark">JERG<span class="ml-nav-dot">.</span>STUDIO</span>
      </a>

      <a href={waUrl} target="_blank" rel="noopener noreferrer" class="ml-nav-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hablar ahora
      </a>
    </nav>

    <main>

      <!-- ══════════════════════════════════
           HERO
      ══════════════════════════════════ -->
      <section class="ml-hero" aria-labelledby="hero-heading">
        <div class="ml-hero-glow" aria-hidden="true"></div>

        <div class="ml-hero-inner">
          <!-- Badge -->
          <div class="ml-badge fade-up">
            <svg width="16" height="16" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <ellipse cx="24" cy="24" rx="22" ry="22" fill="#FFE600"/>
              <path d="M12 30V20l6 7 6-7v10M30 30V20l4 5 4-5v10" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Para vendedores Gold y Platinum de ML</span>
          </div>

          <!-- Headline -->
          <h1 id="hero-heading" class="ml-hero-title fade-up">
            Vendés bien en ML.<br/>
            <em class="ml-hero-em">Los clientes son de ellos.</em>
          </h1>

          <p class="ml-hero-sub fade-up">
            Cada compra que pasa por ML es un cliente que no sabe cómo encontrarte directamente.
            Construimos lo que falta: tu tienda, tu catálogo en WhatsApp y tus automatizaciones.
          </p>

          <!-- Stats row -->
          <div class="ml-stats fade-up" role="list">
            <div class="ml-stat" role="listitem">
              <span class="ml-stat-num">&lt; 1h</span>
              <span class="ml-stat-label">te respondemos hoy mismo</span>
            </div>
            <div class="ml-stat-divider" aria-hidden="true"></div>
            <div class="ml-stat" role="listitem">
              <span class="ml-stat-num">11 días</span>
              <span class="ml-stat-label">entrega promedio</span>
            </div>
            <div class="ml-stat-divider" aria-hidden="true"></div>
            <div class="ml-stat" role="listitem">
              <span class="ml-stat-num">22%</span>
              <span class="ml-stat-label">lo que ML cobra — y ya no pagás</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="ml-hero-ctas fade-up">
            <div class="ml-cta-row">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-cta-primary"
                id="hero-cta"
              >
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Quiero construir lo mío
              </a>
              <a href="#ventajas" class="ml-cta-secondary" aria-label="Ver ventajas frente a MercadoLibre">
                Ver ventajas
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </a>
            </div>
            <span class="ml-cta-hint">Respuesta en menos de 1h</span>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════
           VENTAJAS VS ML
      ══════════════════════════════════ -->
      <section id="ventajas" class="ml-ventajas" aria-labelledby="ventajas-heading">
        <div class="ml-section-inner">

          <div class="ml-ventajas-header fade-up">
            <div class="ml-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
              </svg>
              <span>Comparativa real</span>
            </div>
            <h2 id="ventajas-heading" class="ml-section-title">
              Lo que cambia cuando<br/><em class="ml-hero-em">el negocio es tuyo</em>
            </h2>
            <p class="ml-ventajas-sub">
              ML es un canal de ventas, no tu negocio. Acá está la diferencia de construir lo tuyo.
            </p>
          </div>

          <!-- Tabla comparativa -->
          <div class="ml-compare fade-up" role="table" aria-label="Comparativa MercadoLibre vs JERG.STUDIO">

            <!-- Cabecera -->
            <div class="ml-compare-head" role="row">
              <div class="ml-compare-head-blank" role="columnheader" aria-label="Aspecto"></div>
              <div class="ml-compare-head-ml" role="columnheader">
                <svg width="18" height="18" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <ellipse cx="24" cy="24" rx="22" ry="22" fill="#FFE600"/>
                  <path d="M12 30V20l6 7 6-7v10M30 30V20l4 5 4-5v10" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Solo ML
              </div>
              <div class="ml-compare-head-us" role="columnheader">
                <svg width="16" height="16" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <rect width="32" height="32" rx="8" fill="url(#cvlg)"/>
                  <path d="M8 12L14 16L8 20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 20H24" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                  <defs><linearGradient id="cvlg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse"><stop stop-color="#10b981"/><stop offset="1" stop-color="#34d399"/></linearGradient></defs>
                </svg>
                Con JERG
              </div>
            </div>

            <!-- Filas -->
            {[
              {
                aspect: "Comisión por venta",
                ml: "Hasta 22% en cada venta",
                us: "0% en tu tienda propia",
                mlBad: true,
              },
              {
                aspect: "Tus clientes",
                ml: "Son de ML, no los conocés",
                us: "Tu base de datos, para siempre",
                mlBad: true,
              },
              {
                aspect: "Control del negocio",
                ml: "Pueden pausarte o sancionarte",
                us: "Vos decidís todo, sin depender de nadie",
                mlBad: true,
              },
              {
                aspect: "Preguntas de compradores",
                ml: "Respondés una por una, manual",
                us: "Las repetidas se responden solas",
                mlBad: true,
              },
              {
                aspect: "Gestión de stock",
                ml: "Actualización manual en cada canal",
                us: "Sincronizado automático entre canales",
                mlBad: true,
              },
              {
                aspect: "Visibilidad de marca",
                ml: "Tu marca queda detrás de ML",
                us: "Tu dominio, tu identidad, tu SEO",
                mlBad: true,
              },
            ].map(({ aspect, ml: mlText, us, mlBad }) => (
              <div class="ml-compare-row" role="row">
                <div class="ml-compare-aspect" role="cell">{aspect}</div>
                <div class={`ml-compare-cell ml-compare-cell--ml${mlBad ? ' ml-compare-cell--bad' : ''}`} role="cell">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                  {mlText}
                </div>
                <div class="ml-compare-cell ml-compare-cell--us" role="cell">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {us}
                </div>
              </div>
            ))}

          </div>

          <!-- CTA inline -->
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="ml-cta-primary fade-up" id="ventajas-cta">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quiero lo que me falta
          </a>

        </div>
      </section>

      <!-- ══════════════════════════════════
           SERVICIOS GRID
      ══════════════════════════════════ -->
      <section class="ml-services" aria-labelledby="services-heading">
        <div class="ml-section-inner">
          <h2 id="services-heading" class="ml-section-title fade-up">
            Lo que armamos para vos
          </h2>

          <div class="ml-grid fade-up">
            {services.map(({ iconColor, icon, title: t, desc }) => (
              <div class="ml-card">
                <div class={`ml-icon-badge ml-icon-badge--${iconColor}`} set:html={icon} aria-hidden="true" />
                <h3 class="ml-card-title">{t}</h3>
                <p class="ml-card-desc">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════
           TESTIMONIOS
      ══════════════════════════════════ -->
      <section class="ml-testimonials" aria-labelledby="testimonials-heading">
        <div class="ml-section-inner">
          <h2 id="testimonials-heading" class="ml-section-title fade-up">
            Lo que dicen los vendedores que ya lo armaron
          </h2>

          <div class="ml-testi-grid fade-up">
            {testimonials.map(({ quote, name, role }) => (
              <figure class="ml-testi-card">
                <blockquote class="ml-testi-quote">
                  <p>"{quote}"</p>
                </blockquote>
