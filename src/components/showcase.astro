---
import ContentSection from "~/components/content-section.astro";

const projects = [
  {
    title: "Cal.com",
    category: "Agenda de citas online",
    stars: "41k",
    desc: "Tu propio sistema de reservas, con tu marca y sin pagar comisiones. Tus clientes eligen el día y la hora directamente desde tu web — igual que Calendly, pero tú eres el dueño.",
    tech: ["Next.js", "TypeScript", "tRPC", "PostgreSQL"],
    color: "#6366f1",
    image: "/projects/calcom.png",
    github: "https://github.com/calcom/cal.com",
    span: "big",
  },
  {
    title: "Medusa Commerce",
    category: "Tienda online avanzada",
    stars: "34k",
    desc: "La base perfecta para una tienda seria. Vende en varios países, cobra en distintas monedas y conecta cualquier pasarela de pago — sin depender de Shopify ni pagar sus comisiones.",
    tech: ["TypeScript", "Node.js", "Stripe", "React"],
    color: "#7c3aed",
    image: "/projects/medusa.png",
    github: "https://github.com/medusajs/medusa",
    span: "sm",
  },
  {
    title: "Typebot.io",
    category: "Asistente virtual 24/7",
    stars: "9.7k",
    desc: "Un asistente que atiende a tus clientes cuando tú no puedes. Responde preguntas, recoge datos de contacto y agenda reuniones — todo automático, sin código.",
    tech: ["Next.js", "TypeScript", "Prisma", "n8n"],
    color: "#f97316",
    image: "/projects/typebot.png",
    github: "https://github.com/baptisteArno/typebot.io",
    span: "sm",
  },
  {
    title: "Dub.co",
    category: "Links inteligentes con métricas",
    stars: "20k+",
    desc: "Acorta tus links y descubre exactamente quién los abre, desde qué país y con qué dispositivo. Ideal para medir campañas y saber qué publicidad realmente funciona.",
    tech: ["Next.js", "TypeScript", "MySQL", "Redis"],
    color: "#0ea5e9",
    image: "/projects/dub.jpg",
    github: "https://github.com/dubinc/dub",
    span: "wide",
  },
];
---

<ContentSection title="Portafolio" id="showcase">
  <Fragment slot="eyebrow">
    <span class="eyebrow tracking-[0.22em]">Casos</span>
  </Fragment>
  <Fragment slot="lead">
    Tecnología open source de primer nivel.<br/>
    <span class="text-primary">Adaptada</span> al negocio de cada cliente.
  </Fragment>

  <div class="bento-grid w-full max-w-6xl fade-up">

    <!-- Cal.com — big (2 cols × 2 rows) -->
    <a
      href={projects[0].github}
      target="_blank"
      rel="noopener noreferrer"
      class="bento-card bento-big group js-bento-card"
      style={`--accent: ${projects[0].color};`}
      aria-label={`Ver ${projects[0].title} en GitHub`}
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img
        src={projects[0].image}
        alt={`${projects[0].title} — interfaz del producto`}
        class="bento-img"
        loading="lazy"
        decoding="async"
      />
      <div class="bento-overlay" aria-hidden="true"></div>
      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[0].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[0].stars}
          </span>
        </div>
        <h3 class="bento-title">{projects[0].title}</h3>
        <p class="bento-desc">{projects[0].desc}</p>
        <div class="bento-footer">
          <div class="flex flex-wrap gap-1.5">
            {projects[0].tech.map(t => <span class="bento-tech">{t}</span>)}
          </div>
          <span class="github-link" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHub
          </span>
        </div>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </a>

    <!-- Medusa — top-right small -->
    <a
      href={projects[1].github}
      target="_blank"
      rel="noopener noreferrer"
      class="bento-card bento-sm group js-bento-card"
      style={`--accent: ${projects[1].color};`}
      aria-label={`Ver ${projects[1].title} en GitHub`}
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img src={projects[1].image} alt={`${projects[1].title}`} class="bento-img" loading="lazy" decoding="async" />
      <div class="bento-overlay" aria-hidden="true"></div>
      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[1].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[1].stars}
          </span>
        </div>
        <h3 class="bento-title">{projects[1].title}</h3>
        <p class="bento-desc bento-desc--sm">{projects[1].desc}</p>
        <span class="github-link mt-auto" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </span>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </a>

    <!-- Typebot — mid-right small -->
    <a
      href={projects[2].github}
      target="_blank"
      rel="noopener noreferrer"
      class="bento-card bento-sm group js-bento-card"
      style={`--accent: ${projects[2].color};`}
      aria-label={`Ver ${projects[2].title} en GitHub`}
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img src={projects[2].image} alt={`${projects[2].title}`} class="bento-img" loading="lazy" decoding="async" />
      <div class="bento-overlay" aria-hidden="true"></div>
      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[2].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[2].stars}
          </span>
        </div>
        <h3 class="bento-title">{projects[2].title}</h3>
        <p class="bento-desc bento-desc--sm">{projects[2].desc}</p>
        <span class="github-link mt-auto" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </span>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </a>

    <!-- Dub.co — full-width bottom -->
    <a
      href={projects[3].github}
      target="_blank"
      rel="noopener noreferrer"
      class="bento-card bento-wide group js-bento-card"
      style={`--accent: ${projects[3].color};`}
      aria-label={`Ver ${projects[3].title} en GitHub`}
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img src={projects[3].image} alt={`${projects[3].title}`} class="bento-img" loading="lazy" decoding="async" />
      <div class="bento-overlay bento-overlay--wide" aria-hidden="true"></div>
      <div class="bento-content bento-content-horizontal">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[3].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[3].stars}
          </span>
        </div>
        <h3 class="bento-title">{projects[3].title}</h3>
        <p class="bento-desc">{projects[3].desc}</p>
        <div class="bento-footer">
          <div class="flex flex-wrap gap-1.5">
            {projects[3].tech.map(t => <span class="bento-tech">{t}</span>)}
          </div>
          <span class="github-link" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Ver en GitHub
          </span>
        </div>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </a>

  </div>

  <!-- Nota open source + CTA -->
  <div class="mt-10 flex flex-col items-center gap-5 fade-up delay-2">
    <p class="open-source-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 8v4l3 3"/></svg>
      Cada proyecto es open source — puedes ver el código completo en GitHub. Tomamos estas bases y las adaptamos al negocio de cada cliente.
    </p>
    <a
      href="https://wa.me/56967657198?text=Hola%2C%20vi%20su%20portafolio%20y%20quiero%20hablar%20sobre%20mi%20proyecto"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary btn-magnetic"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Cuéntanos tu proyecto
    </a>
  </div>

</ContentSection>

<style>
  /* ══════════════════════════════════
     BENTO GRID
  ══════════════════════════════════ */
  .bento-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 300px 300px auto;
    }
    .bento-big  { grid-column: span 2; grid-row: span 2; }
    .bento-sm   { grid-column: span 1; grid-row: span 1; }
    .bento-wide { grid-column: span 3; }
  }

  /* ══════════════════════════════════
     BASE CARD
  ══════════════════════════════════ */
  .bento-card {
    position: relative;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
    cursor: pointer;
    min-height: 240px;
    text-decoration: none;
    border-radius: 0.75rem;
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 0 50px color-mix(in srgb, var(--accent) 18%, transparent),
                inset 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
    transform: translateY(-2px);
  }

  /* ══════════════════════════════════
     SCREENSHOT IMAGE
  ══════════════════════════════════ */
  .bento-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    opacity: 0.55;
  }

  .bento-card:hover .bento-img {
    transform: scale(1.04);
    opacity: 0.7;
  }

  /* ══════════════════════════════════
     GRADIENT OVERLAY — más oscuro para mejor legibilidad
  ══════════════════════════════════ */
  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(4, 4, 4, 1)    0%,
      rgba(4, 4, 4, 0.88) 40%,
      rgba(4, 4, 4, 0.5)  65%,
      rgba(4, 4, 4, 0.15) 100%
    );
    z-index: 1;
  }

  .bento-overlay--wide {
    background: linear-gradient(
      to right,
      rgba(4, 4, 4, 1)    0%,
      rgba(4, 4, 4, 0.92) 45%,
      rgba(4, 4, 4, 0.5)  70%,
      rgba(4, 4, 4, 0.1)  100%
    );
  }

  /* ══════════════════════════════════
     CARD SHINE
  ══════════════════════════════════ */
  .card-shine {
    --shine-x: 50%;
    --shine-y: 50%;
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--shine-x) var(--shine-y), rgba(255,255,255,0.06), transparent 65%);
    opacity: 0;
    pointer-events: none;
    z-index: 4;
    transition: opacity 0.3s;
    border-radius: inherit;
  }

  /* ══════════════════════════════════
     CONTENT LAYER
  ══════════════════════════════════ */
  .bento-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1.5rem;
    color: white;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .bento-content-horizontal {
      justify-content: center;
      padding: 2rem 2.5rem;
      max-width: 55%;
    }
  }

  .bento-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  /* ══════════════════════════════════
     BADGES
  ══════════════════════════════════ */
  .bento-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    padding: 0.22rem 0.75rem;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: white;
    backdrop-filter: blur(8px);
  }

  .github-star-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 9999px;
    border: 1px solid rgba(251, 191, 36, 0.5);
    background: rgba(251, 191, 36, 0.18);
    padding: 0.22rem 0.6rem;
    font-size: 0.67rem;
    font-weight: 700;
    color: #fbbf24;
    backdrop-filter: blur(8px);
  }

  /* ══════════════════════════════════
     TIPOGRAFÍA — más legible
  ══════════════════════════════════ */
  .bento-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.8);
  }

  .bento-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65;
    text-shadow: 0 1px 8px rgba(0,0,0,0.9);
    max-width: 38rem;
  }

  /* Descripción en cards pequeñas: tamaño reducido pero visible */
  .bento-desc--sm {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bento-tech {
    display: inline-flex;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.55);
    padding: 0.12rem 0.65rem;
    font-size: 0.64rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
  }

  /* ══════════════════════════════════
     GITHUB LINK
  ══════════════════════════════════ */
  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.71rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    padding: 0.28rem 0.75rem;
    backdrop-filter: blur(8px);
    background: rgba(0, 0, 0, 0.45);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    flex-shrink: 0;
  }

  .bento-card:hover .github-link {
    color: white;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.65);
  }

