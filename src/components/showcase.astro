---
import ContentSection from "~/components/content-section.astro";

/**
 * Open-source reference projects. Each one is a real, verifiable project on
 * GitHub that the studio builds, adapts, and deploys for its clients.
 */
const projects = [
  {
    title: "Cal.com",
    category: "App de Reservas SaaS",
    result: "★ 41k en GitHub",
    stars: "41k",
    desc: "Infraestructura de reservas open source para absolutamente todos. Multi-calendario, pagos integrados, video llamadas y API pública. Lo mismo que Calendly — pero en tu servidor, con tu marca y sin comisiones.",
    tech: ["Next.js", "TypeScript", "tRPC", "PostgreSQL"],
    color: "#6366f1",
    github: "https://github.com/calcom/cal.com",
    live: "https://cal.com",
    span: "big",
  },
  {
    title: "Medusa Commerce",
    category: "E-commerce Headless",
    result: "★ 22k en GitHub",
    stars: "22k",
    desc: "Plataforma headless para tiendas D2C, B2B y marketplaces. Multi-región, multi-moneda y pagos con Stripe listos desde el día uno.",
    tech: ["TypeScript", "Node.js", "Stripe", "React"],
    color: "#7c3aed",
    github: "https://github.com/medusajs/medusa",
    live: "https://medusajs.com",
    span: "sm",
  },
  {
    title: "Typebot.io",
    category: "Chatbot + Automatización",
    result: "★ 9.7k en GitHub",
    stars: "9.7k",
    desc: "Constructor visual de chatbots conversacionales. Captura leads, califica prospectos y automatiza onboarding sin tocar código.",
    tech: ["Next.js", "TypeScript", "Prisma", "n8n"],
    color: "#f97316",
    github: "https://github.com/baptisteArno/typebot.io",
    live: "https://typebot.io",
    span: "sm",
  },
  {
    title: "Dub.co",
    category: "SaaS de Marketing Digital",
    result: "100M+ clicks · ★ 20k+ GitHub",
    stars: "20k+",
    desc: "Links inteligentes con analytics avanzados: geotargeting, device targeting, UTMs automáticos y retargeting. Usado por Vercel, Raycast y Perplexity para sus campañas de marketing.",
    tech: ["Next.js", "TypeScript", "MySQL", "Redis"],
    color: "#0ea5e9",
    github: "https://github.com/dubinc/dub",
    live: "https://dub.co",
    span: "wide",
  },
];
---

<ContentSection title="Portafolio" id="showcase">
  <Fragment slot="eyebrow">
    <span class="eyebrow tracking-[0.22em]">Casos</span>
  </Fragment>
  <Fragment slot="lead">
    Tecnología open source verificable.<br/>
    <span class="text-primary">Adaptada</span> para el negocio de cada cliente.
  </Fragment>

  <!-- Bento grid -->
  <div class="bento-grid w-full max-w-6xl">

    <!-- Cal.com — big (2 cols × 2 rows) -->
    <div class="bento-card bento-big group js-bento-card" style="--accent: #6366f1;">
      <div class="card-shine" aria-hidden="true"></div>

      <!-- CSS device mockup: scheduling dashboard -->
      <div class="device-scene" aria-hidden="true">
        <div class="dev-laptop">
          <div class="dev-cam"></div>
          <div class="dev-screen">
            <div class="ui-cal">
              <div class="ui-cal-hdr"></div>
              <div class="ui-cal-body">
                <div class="ui-cal-side"></div>
                <div class="ui-cal-main">
                  <div class="ui-cal-grid">
                    {Array.from({length:15}).map((_,i) => (
                      <div class={`ui-cal-slot ${[2,5,8,11].includes(i) ? "booked" : ""}`}></div>
                    ))}
                  </div>
                  <div class="ui-cal-stat" style="background:#6366f1;width:72%"></div>
                  <div class="ui-line" style="width:55%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="dev-phone">
          <div class="dev-notch"></div>
          <div class="dev-screen">
            <div class="ui-phone" style="background:#0f0e2a">
              <div class="ui-ph-bar" style="background:#6366f1"></div>
              <div class="ui-ph-slot" style="border-left-color:#6366f1"></div>
              <div class="ui-ph-slot" style="border-left-color:#4f46e5;opacity:.5"></div>
              <div class="ui-ph-btn" style="background:#6366f1"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[0].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[0].stars}
          </span>
        </div>
        <h3 class="bento-title">{projects[0].title}</h3>
        <p class="bento-desc">{projects[0].desc}</p>
        <div class="bento-footer">
          <div class="flex flex-wrap gap-1.5">
            {projects[0].tech.map(t => <span class="bento-tech">{t}</span>)}
          </div>
          <a
            href={projects[0].github}
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
            aria-label={`Ver ${projects[0].title} en GitHub`}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHub
          </a>
        </div>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </div>

    <!-- Medusa Commerce — top-right small -->
    <div class="bento-card bento-sm group js-bento-card" style="--accent: #7c3aed;">
      <div class="card-shine" aria-hidden="true"></div>

      <!-- CSS device mockup: headless store -->
      <div class="device-scene" aria-hidden="true">
        <div class="dev-laptop">
          <div class="dev-cam"></div>
          <div class="dev-screen">
            <div class="ui-store">
              <div class="ui-store-nav"></div>
              <div class="ui-store-hero" style="background:linear-gradient(135deg,#7c3aed,#4c1d95)"></div>
              <div class="ui-store-grid">
                <div class="ui-store-item"></div>
                <div class="ui-store-item"></div>
                <div class="ui-store-item"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="dev-phone">
          <div class="dev-notch"></div>
          <div class="dev-screen">
            <div class="ui-phone" style="background:#faf7ff">
              <div class="ui-ph-bar" style="background:#7c3aed"></div>
              <div class="ui-ph-card" style="background:#ede9fe;border:none"></div>
              <div class="ui-ph-btn" style="background:#7c3aed"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[1].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            {projects[1].stars}
          </span>
        </div>
        <h3 class="bento-title text-lg">{projects[1].title}</h3>
        <a href={projects[1].github} target="_blank" rel="noopener noreferrer" class="github-link mt-auto">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </a>
      </div>
      <span class="card-accent-line" aria-hidden="true"></span>
    </div>

    <!-- Typebot.io — mid-right small -->
    <div class="bento-card bento-sm group js-bento-card" style="--accent: #f97316;">
      <div class="card-shine" aria-hidden="true"></div>

      <!-- CSS device mockup: chatbot builder -->
      <div class="device-scene" aria-hidden="true">
        <div class="dev-laptop">
          <div class="dev-cam"></div>
          <div class="dev-screen">
            <div class="ui-chat">
              <div class="ui-chat-hdr"></div>
              <div class="ui-chat-body">
                <div class="ui-bubble-bot"></div>
                <div class="ui-bubble-user"></div>
                <div class="ui-bubble-bot ui-bubble-bot--sm"></div>
                <div class="ui-bubble-user ui-bubble-user--sm"></div>
                <div class="ui-bubble-cta"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="dev-phone">
          <div class="dev-notch"></div>
          <div class="dev-screen">
            <div class="ui-phone" style="background:#0c0a08">
              <div class="ui-ph-bar" style="background:#f97316"></div>
              <div class="ui-ph-card" style="border-left-color:#f97316;background:#1c1410"></div>
              <div class="ui-ph-btn" style="background:#f97316"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[2].category}</span>
          <span class="github-star-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
