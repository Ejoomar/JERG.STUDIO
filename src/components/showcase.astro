<style>
  /* ══════════════════════════════════
     BENTO GRID LAYOUT
  ══════════════════════════════════ */
  .bento-grid {
    display: grid;
    gap: 0.625rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 240px 240px auto;
    }
    .bento-big  { grid-column: span 2; grid-row: span 2; }
    .bento-sm   { grid-column: span 1; grid-row: span 1; }
    .bento-wide { grid-column: span 3; }
  }

  /* ══════════════════════════════════
     BASE CARD
  ══════════════════════════════════ */
  .bento-card {
    position: relative;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color 0.3s, box-shadow 0.3s;
    cursor: pointer;
    min-height: 220px;
    transform-style: preserve-3d;
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  /* ══════════════════════════════════
     CARD SHINE (3D tilt reflection)
  ══════════════════════════════════ */
  .card-shine {
    --shine-x: 50%;
    --shine-y: 50%;
    position: absolute;
    inset: 0;
    background: radial-gradient(350px circle at var(--shine-x) var(--shine-y), rgba(255,255,255,0.07), transparent 65%);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
    transition: opacity 0.3s;
  }

  /* ══════════════════════════════════
     CONTENT LAYER
  ══════════════════════════════════ */
  .bento-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.25rem;
    color: white;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .bento-content-horizontal {
      justify-content: center;
      padding: 2rem;
    }
  }

  .bento-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  /* ══════════════════════════════════
     BADGES
  ══════════════════════════════════ */
  .bento-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 0.2rem 0.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: white;
    backdrop-filter: blur(8px);
  }

  .github-star-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 9999px;
