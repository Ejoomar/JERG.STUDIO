---
import ContentSection from "~/components/content-section.astro";

const projects = [
  {
    title: "FounderOS",
    category: "App Web SaaS",
    result: "↑ 8x retención de usuarios",
    desc: "Dashboard all-in-one para founders en etapa pre-seed: gestión de tareas, pipeline de inversores y métricas clave. MVP lanzado en 3 semanas con 0 bugs en producción.",
    tech: ["React", "Supabase", "Vercel"],
    image: "https://placehold.co/900x600/0a0a0a/6366f1?text=FounderOS",
    color: "#6366f1",
    span: "big",
  },
  {
    title: "PelicanDTC",
    category: "E-commerce D2C",
    result: "↑ 250% ventas primer mes",
    desc: "Tienda D2C con Stripe y gestión de stock.",
    tech: ["Astro", "Stripe"],
    image: "https://placehold.co/600x300/0a0a0a/22d3ee?text=PelicanDTC",
    color: "#22d3ee",
    span: "sm",
  },
  {
    title: "TallerFlow",
    category: "App Reservas",
    result: "↓ 70% ausencias a citas",
    desc: "Sistema de agenda y seguimiento para talleres.",
    tech: ["Next.js", "Supabase"],
    image: "https://placehold.co/600x300/0a0a0a/8b5cf6?text=TallerFlow",
    color: "#8b5cf6",
    span: "sm",
  },
  {
    title: "SeedLanding",
    category: "Landing + Automatización",
    result: "+800 leads / mes",
    desc: "Landing page de alta conversión para startup fintech con embudo automatizado: captura, calificación por WhatsApp y nurturing por email. Integrado con n8n y Supabase.",
    tech: ["Astro", "n8n", "WhatsApp API"],
    image: "https://placehold.co/1200x280/0a0a0a/10b981?text=SeedLanding",
    color: "#10b981",
    span: "wide",
  },
];
---

<ContentSection title="Portfolio" id="showcase">
  <Fragment slot="eyebrow">
    <span class="eyebrow tracking-[0.22em]">Casos</span>
  </Fragment>
  <Fragment slot="lead">
    Casos reales, resultados medibles.<br/>
    <span class="text-primary">Startups</span> que apostaron por lo bien hecho.
  </Fragment>

  <!-- Bento grid -->
  <div class="bento-grid w-full max-w-6xl fade-up">

    <!-- P1: Featured (2 cols, 2 rows) -->
    <a
      href="#contact"
      class="bento-card bento-big group"
      style="--accent: #6366f1;"
      aria-label="Proyecto FounderOS — App Web SaaS"
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img
        src={projects[0].image}
        alt="Captura del proyecto FounderOS"
        class="bento-img"
        loading="eager"
        width="900" height="600"
      />
      <div class="bento-overlay"></div>
      <div class="bento-content">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[0].category}</span>
          <span class="bento-result">{projects[0].result}</span>
        </div>
        <h3 class="bento-title">{projects[0].title}</h3>
        <p class="bento-desc">{projects[0].desc}</p>
        <div class="flex flex-wrap gap-1.5 mt-auto">
          {projects[0].tech.map(t => (
            <span class="bento-tech">{t}</span>
          ))}
        </div>
      </div>
    </a>

    <!-- P2: top-right -->
    <a
      href="#contact"
      class="bento-card bento-sm group"
      style="--accent: #22d3ee;"
      aria-label="Proyecto PelicanDTC — E-commerce D2C"
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img
        src={projects[1].image}
        alt="Captura del proyecto PelicanDTC"
        class="bento-img"
        loading="lazy"
        width="600" height="300"
      />
      <div class="bento-overlay"></div>
      <div class="bento-content">
        <span class="bento-badge">{projects[1].category}</span>
        <h3 class="bento-title text-lg">{projects[1].title}</h3>
        <p class="bento-result-inline">{projects[1].result}</p>
      </div>
    </a>

    <!-- P3: mid-right -->
    <a
      href="#contact"
      class="bento-card bento-sm group"
      style="--accent: #8b5cf6;"
      aria-label="Proyecto TallerFlow — App Reservas"
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img
        src={projects[2].image}
        alt="Captura del proyecto TallerFlow"
        class="bento-img"
        loading="lazy"
        width="600" height="300"
      />
      <div class="bento-overlay"></div>
      <div class="bento-content">
        <span class="bento-badge">{projects[2].category}</span>
        <h3 class="bento-title text-lg">{projects[2].title}</h3>
        <p class="bento-result-inline">{projects[2].result}</p>
      </div>
    </a>

    <!-- P4: Full-width bottom (horizontal card) -->
    <a
      href="#contact"
      class="bento-card bento-wide group"
      style="--accent: #10b981;"
      aria-label="Proyecto SeedLanding — Landing + Automatización"
    >
      <div class="card-shine" aria-hidden="true"></div>
      <img
        src={projects[3].image}
        alt="Captura del proyecto SeedLanding"
        class="bento-img"
        loading="lazy"
        width="1200" height="280"
      />
      <div class="bento-overlay"></div>
      <div class="bento-content bento-content-horizontal">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="bento-badge">{projects[3].category}</span>
          <span class="bento-result">{projects[3].result}</span>
        </div>
        <h3 class="bento-title">{projects[3].title}</h3>
        <p class="bento-desc hidden sm:block">{projects[3].desc}</p>
        <div class="flex flex-wrap gap-1.5 mt-auto">
          {projects[3].tech.map(t => (
            <span class="bento-tech">{t}</span>
          ))}
        </div>
      </div>
    </a>
  </div>

  <!-- CTA -->
  <div class="mt-4 flex justify-center fade-up delay-3">
    <a
      href="https://wa.me/56967657198?text=Hola%2C%20vi%20su%20portfolio%20y%20quiero%20hablar%20sobre%20mi%20proyecto"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary btn-magnetic"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Cuéntanos tu proyecto
    </a>
  </div>
</ContentSection>

<style>
  /* ── Bento grid layout ── */
  .bento-grid {
    display: grid;
    gap: 0.625rem;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 240px 240px auto;
    }
    .bento-big  { grid-column: span 2; grid-row: span 2; }
    .bento-sm   { grid-column: span 1; grid-row: span 1; }
    .bento-wide { grid-column: span 3; grid-row: span 1; }
  }

  /* ── Base card ── */
  .bento-card {
    position: relative;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color 0.3s, box-shadow 0.3s;
    cursor: pointer;
    min-height: 220px;
    /* 3D tilt perspective applied by JS */
    transform-style: preserve-3d;
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  /* ── Card shine (3D tilt reflection) ── */
  .card-shine {
    --shine-x: 50%;
    --shine-y: 50%;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      350px circle at var(--shine-x) var(--shine-y),
      rgba(255, 255, 255, 0.07),
      transparent 65%
    );
    opacity: 0;
    pointer-events: none;
    z-index: 3;
    transition: opacity 0.3s;
  }

  /* ── Image ── */
  .bento-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s;
  }

  .bento-card:hover .bento-img {
    transform: scale(1.04);
    opacity: 0.25;
  }

  /* ── Gradient overlay (always present, intensifies on hover) ── */
  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.3) 50%, transparent 100%);
    transition: opacity 0.4s;
    z-index: 1;
  }

  .bento-card:hover .bento-overlay {
    opacity: 0;
  }

  /* ── Content ── */
  .bento-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.25rem;
    color: white;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .bento-content-horizontal {
      justify-content: center;
      padding: 2rem;
    }
  }

  /* ── Badges ── */
  .bento-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 0.2rem 0.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: white;
    backdrop-filter: blur(8px);
  }

  .bento-result {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    padding: 0.2rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: color-mix(in srgb, var(--accent) 90%, white);
    backdrop-filter: blur(8px);
  }

  .bento-result-inline {
    font-size: 0.78rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--accent) 80%, white);
  }

  /* ── Title / desc ── */
  .bento-title {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.2;
    color: white;
  }

  .bento-desc {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.55;
  }

  /* ── Tech chips ── */
  .bento-tech {
    display: inline-flex;
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.08);
    padding: 0.1rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    backdrop-filter: blur(8px);
  }

  /* Mobile: fixed heights */
  @media (max-width: 767px) {
    .bento-big  { min-height: 340px; }
    .bento-sm   { min-height: 200px; }
    .bento-wide { min-height: 220px; }
  }
</style>
