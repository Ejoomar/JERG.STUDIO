---
import HeroImage from "~/components/hero-image.astro";
import Starfield from "~/components/starfield.astro";

const stats = [
  { num: "40+",  label: "Lanzamientos", count: 40,  suffix: "+" },
  { num: "3sem", label: "Entrega avg",  count: 3,   suffix: "sem" },
  { num: "100%", label: "Satisfacción", count: 100, suffix: "%" },
];
---

<section class="relative h-full bg-black overflow-hidden">
  <Starfield />

  <!-- Grid muy sutil -->
  <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Glow que sigue al mouse / giroscopio via GSAP -->
  <div
    id="hero-glow"
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 55% at 50% 42%, rgba(16,185,129,0.10) 0%, rgba(5,5,5,0.55) 60%, rgba(5,5,5,0.98) 100%)"
    aria-hidden="true"
  ></div>

  <!-- Noscript fallback -->
  <div id="splash-bg-fallback" class="absolute inset-0 hidden opacity-40">
    <HeroImage />
  </div>

  <!-- Número decorativo de fondo — da profundidad -->
  <div class="hero-bg-mark" aria-hidden="true">JS</div>

  <!-- Contenido principal -->
  <div class="relative flex h-full flex-col items-center justify-center px-6 text-center">

    <!-- Categoría — mínima, arriba -->
    <p
      class="fade-up mb-7 text-[10px] font-bold uppercase text-white/20"
      style="letter-spacing: 0.38em;"
      aria-hidden="true"
      data-scramble
    >
      Agencia de Desarrollo Digital
    </p>

    <!-- Headline MASIVO — 3 líneas, llena la pantalla -->
    <h1
      class="fade-up delay-1 uppercase"
      style="font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(3.8rem, 11vw, 9.5rem); line-height: 0.92; letter-spacing: -0.025em; font-weight: 400; color: #f5f0e8;"
    >
      CONSTRUIMOS<br/>
      <em style="color: #10b981; font-style: italic;">PRESENCIAS</em><br/>
      DIGITALES.
    </h1>

    <!-- Subline — mínima, 1 línea -->
    <p
      class="fade-up delay-2 mt-9 text-white/35"
      style="font-size: 0.9rem; letter-spacing: 0.08em; max-width: 26rem; line-height: 1.7;"
    >
      Código que convierte. Diseño que impacta.<br/>Resultados que se miden.
    </p>

    <!-- CTAs -->
    <div class="fade-up delay-3 mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://wa.me/56967657198?text=Hola%2C%20quiero%20lanzar%20mi%20proyecto%20con%20JERG.STUDIO"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary btn-magnetic"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Iniciar proyecto
      </a>
      <a href="#features" class="btn-ghost btn-magnetic">
        Capacidades
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Stats — compactos, tras divisor -->
    <div class="fade-up delay-4 stats-row mt-14 flex items-center gap-10 border-t border-white/8 pt-8">
      {stats.map((s, i) => (
        <div class={`flex flex-col items-center gap-1.5 ${i > 0 ? "border-l border-white/8 pl-10" : ""}`}>
          <span
            class="gradient-text font-display font-extrabold"
            style="font-size: clamp(1.5rem, 2.2vw, 2.2rem); line-height: 1;"
            data-count={s.count}
            data-suffix={s.suffix}
          >{s.num}</span>
          <span class="text-[9px] font-bold uppercase text-white/25" style="letter-spacing: 0.22em;">{s.label}</span>
        </div>
      ))}
    </div>

    <!-- Scroll hint -->
    <div class="fade-up delay-5 absolute bottom-7 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2.5" aria-hidden="true">
      <span class="text-[8px] font-bold uppercase text-white/15" style="letter-spacing: 0.35em;">Scroll para descubrir</span>
      <div class="h-8 w-px animate-pulse-slow" style="background: linear-gradient(to bottom, rgba(99,102,241,0.6), transparent);"></div>
    </div>
  </div>
</section>

<noscript>
  <style>#splash-bg-fallback { display: block; }</style>
</noscript>

<style>
  /* Grid decorativo muy sutil */
  .hero-grid {
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 85% 85% at 50% 40%, black 25%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 40%, black 25%, transparent 100%);
  }

  /* Letras decorativas de fondo — dan profundidad/textura */
  .hero-bg-mark {
    position: absolute;
    bottom: -4vw;
    right: -2vw;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(10rem, 28vw, 28rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.07em;
    color: rgba(16, 185, 129, 0.04);
    pointer-events: none;
    user-select: none;
    text-transform: uppercase;
  }

  /* Divisor de stats */
  .border-white\/8 { border-color: rgba(255, 255, 255, 0.08); }

  /* Scroll pulse */
  .animate-pulse-slow {
    animation: hpulse 2.8s ease-in-out infinite;
  }
  @keyframes hpulse {
    0%, 100% { opacity: 0.25; }
    50%       { opacity: 0.9; }
  }

  /* Ajuste móvil: stats más compactos */
  @media (max-width: 480px) {
    .stats-row { gap: 1.5rem; }
    .stats-row > div + div { padding-left: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#starfield) { display: none; }
    #splash-bg-fallback  { display: block; }
    .animate-pulse-slow  { animation: none; }
    .hero-grid           { display: none; }
    .hero-bg-mark        { display: none; }
  }
</style>
