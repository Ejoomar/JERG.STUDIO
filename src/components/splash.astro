---
import HeroImage from "~/components/hero-image.astro";
import Starfield from "~/components/starfield.astro";

const stats = [
  { num: "40+",  label: "Proyectos",   count: 40, suffix: "+"   },
  { num: "3sem", label: "Tiempo promedio", count: 3,  suffix: "sem" },
  { num: "98%",  label: "Recomiendan", count: 98, suffix: "%"   },
];
---

<section id="splash" class="relative h-full bg-black overflow-x-hidden">
  <Starfield />

  <!-- Grid muy sutil -->
  <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Glow que sigue al mouse / giroscopio via GSAP -->
  <div
    id="hero-glow"
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 55% at 50% 42%, rgba(16,185,129,0.10) 0%, rgba(5,5,5,0.55) 60%, rgba(5,5,5,0.98) 100%)"
    aria-hidden="true"
  ></div>

  <!-- Noscript fallback -->
  <div id="splash-bg-fallback" class="absolute inset-0 hidden opacity-40">
    <HeroImage />
  </div>

  <!-- Marca decorativa de fondo — da profundidad -->
  <div class="hero-bg-mark" aria-hidden="true">JERG</div>

  <!-- Contenido principal -->
  <div class="relative flex h-full flex-col items-center justify-center px-6 pb-10 text-center">

    <!-- Categoría — mínima, arriba -->
    <p
      class="fade-up mb-7 text-[10px] font-bold uppercase text-white/70"
      style="letter-spacing: 0.38em;"
      aria-hidden="true"
      data-scramble
    >
      Estudio Digital · Latinoamérica
    </p>

    <!-- Headline MASIVO — 3 líneas, llena la pantalla -->
    <h1
      class="fade-up delay-1 uppercase"
      style="font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(2.8rem, 10vw, 9.5rem); line-height: 0.94; letter-spacing: -0.025em; font-weight: 400; color: #f5f0e8;"
    >
      CONSTRUIMOS<br/>
      <em style="color: #10b981; font-style: italic;">PRESENCIAS</em><br/>
      DIGITALES.
    </h1>

    <!-- Subline — mínima, 1 línea -->
    <p
      class="fade-up delay-2 mt-9 text-white/65"
      style="font-size: 0.95rem; letter-spacing: 0.06em; max-width: 26rem; line-height: 1.7;"
    >
      Lanzamos tu web o app en semanas,<br/>con precio fijo acordado desde el principio.
    </p>

    <!-- CTAs -->
    <div class="fade-up delay-3 mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="#contact" class="btn-primary btn-magnetic">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Cuéntanos tu idea
      </a>
      <a href="#process" class="btn-ghost btn-magnetic">
        Ver cómo trabajamos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Stats — compactos, tras divisor -->
    <div class="fade-up delay-4 stats-row mt-14 flex items-center gap-10 border-t border-white/8 pt-8">
      {stats.map((s, i) => (
        <div class={`flex flex-col items-center gap-1.5 ${i > 0 ? "border-l border-white/8 pl-10" : ""}`}>
          <span
            class="gradient-text font-display font-extrabold"
            style="font-size: clamp(1.5rem, 2.2vw, 2.2rem); line-height: 1;"
            data-count={s.count}
            data-suffix={s.suffix}
          >{s.num}</span>
          <span class="text-[11px] font-bold uppercase text-white/25" style="letter-spacing: 0.18em;">{s.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<noscript>
  <style>#splash-bg-fallback { display: block; }</style>
</noscript>

<style>
  /* Grid decorativo muy sutil */
  .hero-grid {
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 85% 85% at 50% 40%, black 25%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 40%, black 25%, transparent 100%);
  }

  /* Letras decorativas de fondo — dan profundidad/textura */
  .hero-bg-mark {
    position: absolute;
    bottom: -4vw;
    right: -2vw;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(10rem, 28vw, 28rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.07em;
    color: rgba(16, 185, 129, 0.04);
    pointer-events: none;
    user-select: none;
    text-transform: uppercase;
  }

  /* Divisor de stats */
  .border-white\/8 { border-color: rgba(255, 255, 255, 0.08); }

  /* Scroll pulse */
  .animate-pulse-slow {
    animation: hpulse 2.8s ease-in-out infinite;
  }
  @keyframes hpulse {
    0%, 100% { opacity: 0.25; }
    50%       { opacity: 0.9; }
  }

  /* Ajuste móvil: stats más compactos */
  @media (max-width: 480px) {
    .stats-row {
      gap: 1.25rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
      border-top: none;
      padding-top: 0;
    }
    .stats-row > div {
      border-left: none !important;
      padding-left: 0 !important;
    }
  }

  @media (max-width: 480px) {
    h1 {
      letter-spacing: -0.01em !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#starfield) { display: none; }
    #splash-bg-fallback  { display: block; }
    .animate-pulse-slow  { animation: none; }
    .hero-grid           { display: none; }
    .hero-bg-mark        { display: none; }
  }
</style>
