---

<ContentSection title="Las herramientas que construyen lo que diseñamos" id="clients">
  <Fragment slot="eyebrow">
    <span class="eyebrow">Stack</span>
  </Fragment>
  <Fragment slot="lead">
    Stack moderno, open source y probado en producción. Sin dependencias propietarias.
  </Fragment>

  <div class="w-full overflow-hidden fade-up" aria-label="Stack tecnológico del estudio">

    <!-- Fila 1 → izquierda, 35 s -->
    <div class="marquee-outer mb-3">
      <div class="marquee-track row-1">
        {[...row1, ...row1].map((t, i) => (
          <div
            class="tech-card"
            style={`--brand: ${t.brand};`}
            aria-hidden={i >= row1.length ? "true" : undefined}
          >
            <span class="tech-logo" set:html={t.svg} />
            <span class="tech-name">{t.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Fila 2 ← derecha, 28 s -->
    <div class="marquee-outer">
      <div class="marquee-track marquee-reverse row-2">
        {[...row2, ...row2].map((t, i) => (
          <div
            class="tech-card"
            style={`--brand: ${t.brand};`}
            aria-hidden={i >= row2.length ? "true" : undefined}
          >
            <span class="tech-logo" set:html={t.svg} />
            <span class="tech-name">{t.name}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</ContentSection>

<style>
  /* ── Marquee outer: fade edges ── */
  .marquee-outer {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  /* ── Track ── */
  .marquee-track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: marquee-left 35s linear infinite;
  }

  /* Per-row durations (avoids inline style being overridden by global !important) */
  .row-1 { animation-duration: 35s; }
  .row-2 { animation-duration: 28s; }

  .marquee-reverse {
    animation-name: marquee-right;
  }

  /* Pause on hover over the row */
  .marquee-track:hover {
    animation-play-state: paused;
  }

  /*
   * Override the aggressive global `* { animation-duration: 0.01ms !important }`
   * that fires when the OS has "Reduce animations" ON.
   * The marquee is a slow, continuous loop — safe for vestibular purposes.
   * A scoped class selector beats the universal `*` in specificity, so
   * these !important declarations win the cascade.
   */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-play-state: running !important;
    }
    .row-1 { animation-duration: 35s !important; }
    .row-2 { animation-duration: 28s !important; }
  }

  /* ── Tech card ── */
  .tech-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: clamp(120px, 35vw, 150px);
    height: 130px;
    padding: 1.25rem 1.5rem;
