---
import ContentSection from "~/components/content-section.astro";

const faqs = [
  {
    q: "¿Cuánto cuesta una landing page para mi startup?",
    a: "Landing pages a partir de $300 USD y apps o sistemas a partir de $500 USD — el precio final depende del alcance, las funcionalidades y la complejidad de tu proyecto. Cada cotización es personalizada y se cierra antes de empezar, sin cobros por hora ni costos adicionales.",
  },
  {
    q: "¿Trabajan con emprendedores que están empezando?",
    a: "Es nuestro cliente favorito. No necesitas tener todo definido: cuéntanos tu idea por WhatsApp o email, analizamos tu proyecto y en menos de 24 horas te enviamos una propuesta clara. Sin llamadas obligatorias, sin formularios complicados.",
  },
  {
    q: "¿Cuánto tarda en estar lista mi web o app?",
    a: "Landing pages: 5 a 10 días hábiles. MVPs y apps web: 3 a 6 semanas. Tendrás un link de preview desde el día 3 del proyecto con iteraciones semanales para dar feedback en tiempo real.",
  },
  {
    q: "¿En qué servidor queda alojada mi página y qué tan segura es?",
    a: "Desplegamos en Vercel o Cloudflare Pages — infraestructura usada por empresas como Airbnb y GitHub. Esto incluye SSL/HTTPS automático, CDN global, protección DDoS y backups automáticos. Tu página carga rápido en cualquier país y está protegida desde el primer día.",
  },
  {
    q: "¿Pueden conectar mi web con mi sistema de inventario u otras herramientas?",
    a: "Sí. Integramos con sistemas de inventario, CRM, WhatsApp Business API, pasarelas de pago (Stripe, PayPal, MercadoPago), Google Analytics, email marketing y más. Si ya tienes un sistema, lo analizamos y te decimos exactamente cómo conectarlo — sin romper lo que ya funciona.",
  },
  {
    q: "¿Pueden hacer que mi web convierta, no solo que se vea bien?",
    a: "Diseñamos para conversión desde el primer wireframe: jerarquía visual, CTA estratégicos, velocidad de carga y copy orientado a la acción. No es solo estética — cada decisión de diseño tiene un propósito.",
  },
  {
    q: "¿Puedo empezar pequeño y escalar después?",
    a: "Sí, y lo recomendamos. Muchos clientes empiezan con una landing page y luego escalan a e-commerce, sistema de reservas o dashboard. Construimos pensando en esa evolución desde el inicio.",
  },
  {
    q: "¿Qué pasa después del lanzamiento?",
    a: "Incluimos 30 días de soporte post-lanzamiento sin costo. Después tienes planes de mantenimiento mensual con hosting gestionado, actualizaciones de seguridad y respaldo semanal. Sin contrato de permanencia.",
  },
];
---

<ContentSection title="Preguntas" id="faq">
  <Fragment slot="eyebrow">
    <span class="eyebrow tracking-[0.22em]">FAQ</span>
  </Fragment>
  <Fragment slot="lead">
    Todo lo que necesitas saber<br/>
    antes de <span class="text-primary">dar el primer paso</span>.
  </Fragment>

  <!-- Layout de 2 columnas: FAQ + panel CTA -->
  <div class="faq-layout w-full max-w-5xl">

    <!-- Columna FAQ -->
    <div class="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item js-faq-item border border-default transition-all duration-200 hover:border-primary/30 mt-[-1px]">
          <button
            class="faq-btn flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left font-semibold transition-colors duration-200 hover:text-primary"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            id={`faq-btn-${i}`}
          >
            <span>{faq.q}</span>
            <svg
              class="faq-icon size-5 shrink-0 text-primary transition-transform duration-300"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div
            class="faq-answer"
            id={`faq-answer-${i}`}
            role="region"
            aria-labelledby={`faq-btn-${i}`}
          >
            <p class="px-6 pb-5 text-sm text-offset leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Panel CTA lateral -->
    <aside class="faq-cta flex flex-col gap-6 border border-default bg-offset p-8" aria-label="Contacto rápido">
      <!-- Ícono decorativo -->
      <div class="flex size-12 items-center justify-center border border-primary/25 bg-primary/10 text-primary">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
      </div>

      <div>
        <h3 class="font-extrabold text-xl mb-2">¿No encuentras tu respuesta?</h3>
        <p class="text-sm text-offset leading-relaxed">
          Cuéntanos tu caso particular. Te respondemos en menos de 24 h con una solución concreta.
        </p>
      </div>

      <a href="#contact" class="btn-primary w-full justify-center">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Enviar consulta
      </a>

      <!-- Divisor -->
      <div class="border-t border-default"></div>

      <!-- Quick facts -->
      <ul class="flex flex-col gap-2.5">
        {[
          "Consulta inicial 100% gratis",
          "Respuesta en menos de 24 h",
          "Sin contrato de permanencia",
        ].map(item => (
          <li class="flex items-center gap-2 text-xs text-offset">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary shrink-0" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</ContentSection>

<style>
  /* ── Layout 2 columnas ── */
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .faq-layout {
      grid-template-columns: 1fr 280px;
    }
    .faq-cta {
      position: sticky;
      top: 6rem;
    }
  }

  /* ── FAQ item — borde izquierdo activo ── */
  .faq-item {
    position: relative;
    transition: border-color 0.2s;
  }

  .faq-item::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: linear-gradient(to bottom, #10b981, #34d399);
    opacity: 0;
    transition: opacity 0.25s;
    z-index: 1;
  }

  .faq-item.is-open::before {
    opacity: 1;
  }

  .faq-item.is-open {
    border-color: rgba(16, 185, 129, 0.3);
  }

  /* ── Answer panel ── */
  .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

</style>

<script>
  // JS sets max-height directly via inline style — avoids Astro scoped CSS issues
  function closeFaqItem(el: Element) {
    el.classList.remove('is-open');
    const b = el.querySelector<HTMLButtonElement>('.faq-btn');
    const a = el.querySelector<HTMLElement>('.faq-answer');
    const i = el.querySelector<HTMLElement>('.faq-icon');
    if (b) b.setAttribute('aria-expanded', 'false');
    if (a) a.style.maxHeight = '0px';
    if (i) i.style.transform = '';
  }

  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn    = item.querySelector<HTMLButtonElement>('.faq-btn');
    const answer = item.querySelector<HTMLElement>('.faq-answer');
    const icon   = item.querySelector<HTMLElement>('.faq-icon');
    if (!btn || !answer) return;

    // Asegurar estado inicial cerrado vía JS
    answer.style.maxHeight = '0px';

    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');

      // Cerrar todos
      document.querySelectorAll<HTMLElement>('.faq-item').forEach(closeFaqItem);

      // Abrir el clickeado si estaba cerrado
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = '600px';
        if (icon) icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
