---
import ContentSection from "~/components/content-section.astro";
---

<ContentSection title="Primeros Clientes" id="testimonials">
  <Fragment slot="eyebrow">
    <span class="eyebrow">Etapa de lanzamiento</span>
  </Fragment>
  <Fragment slot="lead">
    Sé parte de los primeros
    <span class="text-primary">casos de éxito</span>.
  </Fragment>

  <div class="first-client-card">
    <div class="first-client-icon" aria-hidden="true">🚀</div>
    <h3 class="text-xl font-extrabold mb-3">Sé parte de los primeros proyectos</h3>
    <p class="text-sm text-offset leading-relaxed max-w-md mx-auto">
      Estamos en etapa de lanzamiento y trabajamos con un número
      limitado de clientes para entregar resultados excepcionales.
      Primera consulta 100% gratis, sin compromiso.
    </p>
    <div class="first-client-badges">
      <span>✓ Precio especial de lanzamiento</span>
      <span>✓ Atención personalizada directa</span>
      <span>✓ Sin lista de espera por ahora</span>
    </div>
    <a href="#contact" class="btn-primary inline-flex">
      Iniciar proyecto →
    </a>
  </div>
</ContentSection>

<style>
  .first-client-card {
    background: #0d0d0d;
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 3rem 2rem;
    border-radius: 16px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .first-client-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .first-client-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin: 1.5rem 0 2rem;
    font-size: 0.82rem;
    color: #10b981;
    font-weight: 600;
  }

  .first-client-badges span {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.18);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  @media (max-width: 480px) {
    .first-client-card {
      padding: 2rem 1.25rem;
    }
  }
</style>
