---
import ContentSection from "~/components/content-section.astro";

const testimonials = [
  {
    name: "María González",
    role: "Directora General",
    company: "Clínica Vida Plena",
    text: "En 3 semanas teníamos la nueva web y el sistema de citas online. Los leads se triplicaron en el primer mes. Profesionales, rápidos y muy claros en todo momento.",
    initials: "MG",
    color: "#6366f1",
  },
  {
    name: "Carlos Mendoza",
    role: "Gerente de Operaciones",
    company: "ConstructMax",
    text: "El sistema de seguimiento de obras nos ahorró horas de trabajo semanal. La comunicación durante todo el proyecto fue excelente. Totalmente recomendados.",
    initials: "CM",
    color: "#22d3ee",
  },
  {
    name: "Laura Rincón",
    role: "CEO & Fundadora",
    company: "ModaFusión",
    text: "Mi tienda online superó todas las expectativas. En 4 semanas funcionando y mis ventas crecieron un 180% en los primeros dos meses. ¡Increíble equipo!",
    initials: "LR",
    color: "#8b5cf6",
  },
];
---

<ContentSection title="Testimonios" id="testimonials">
  <Fragment slot="eyebrow">
    <span class="eyebrow">Lo que dicen</span>
  </Fragment>
  <Fragment slot="lead">
    Clientes reales, resultados
    <span class="text-primary">comprobables</span>.
  </Fragment>

  <div class="grid w-full max-w-6xl grid-cols-1 gap-px md:grid-cols-3">
    {testimonials.map(({ name, role, company, text, initials, color }) => (
      <blockquote class="group flex flex-col gap-6 border border-default bg-offset p-8 transition-colors duration-300 hover:border-primary/30 cursor-default">
        <!-- Stars -->
        <div class="flex gap-0.5" aria-label="5 de 5 estrellas" role="img">
          {Array.from({ length: 5 }).map(() => (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>

        <!-- Quote mark -->
        <p class="relative text-sm text-offset leading-relaxed flex-1 italic before:content-['"'] before:text-4xl before:text-primary/20 before:font-display before:font-extrabold before:leading-none before:float-left before:mr-1 before:-mt-1">
          {text}
        </p>

        <!-- Author -->
        <footer class="flex items-center gap-3 border-t border-default pt-5">
          <div
            class="flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-bold"
            style={`background: ${color}20; color: ${color}; border: 1px solid ${color}35;`}
            aria-hidden="true"
          >
            {initials}
          </div>
          <div>
            <cite class="not-italic font-extrabold text-sm">{name}</cite>
            <p class="text-xs text-offset">{role}, {company}</p>
          </div>
        </footer>
      </blockquote>
    ))}
  </div>
</ContentSection>
