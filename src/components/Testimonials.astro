---
import ContentSection from "~/components/content-section.astro";
---

<ContentSection title="¿El tuyo es el próximo?" id="testimonials">
  <Fragment slot="eyebrow">
    <span class="eyebrow tracking-[0.22em]">Siguiente proyecto</span>
  </Fragment>
  <Fragment slot="lead">
    Más de 40 proyectos lanzados.<br/>
    El <span class="text-primary">próximo</span> puede ser el tuyo.
  </Fragment>

  <div class="next-project-card">

    <div class="card-body">
      <h3 class="card-title">Hablemos esta semana</h3>
      <p class="card-desc">
        Primera consulta gratuita — por WhatsApp o email.
        Sin formularios largos, sin presentaciones. Nos cuentas tu idea
        y en menos de 24&nbsp;h tienes una propuesta con precio fijo.
      </p>
      <div class="card-badges">
        <span>✓ Respuesta en menos de 24 h</span>
        <span>✓ Presupuesto sin compromiso</span>
        <span>✓ Primera consulta gratis</span>
      </div>
      <a href="#contact" class="btn-primary inline-flex">
        Iniciar conversación
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="card-stat-col" aria-hidden="true">
      <div class="big-stat">
        <span class="stat-num">40<span class="stat-plus">+</span></span>
        <span class="stat-label">proyectos<br/>lanzados</span>
      </div>
      <div class="stat-divider"></div>
      <div class="big-stat">
        <span class="stat-num">98<span class="stat-plus">%</span></span>
        <span class="stat-label">recomiendan<br/>el estudio</span>
      </div>
    </div>

  </div>
</ContentSection>

<style>
  .next-project-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: #0d0d0d;
    border: 1px solid rgba(16, 185, 129, 0.18);
    border-radius: 16px;
    overflow: hidden;
    max-width: 760px;
    margin: 0 auto;
    width: 100%;
  }

  @media (min-width: 640px) {
    .next-project-card {
      grid-template-columns: 1fr auto;
    }
  }

  /* ── Columna izquierda ── */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2.5rem 2rem;
  }

  .card-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: #f5f0e8;
    line-height: 1.15;
  }

  .card-desc {
    font-size: 0.9rem;
    color: rgba(245, 240, 232, 0.5);
    line-height: 1.75;
    max-width: 34rem;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #10b981;
  }

  .card-badges span {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.18);
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
  }

  /* ── Columna derecha: stats visuales ── */
  .card-stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(16, 185, 129, 0.03);
    min-width: 160px;
  }

  @media (min-width: 640px) {
    .card-stat-col {
      border-top: none;
      border-left: 1px solid rgba(255, 255, 255, 0.06);
    }
  }

  .big-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  .stat-num {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 1;
    background: linear-gradient(135deg, #10b981, #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-plus {
    font-size: 1.5rem;
  }

  .stat-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1.4;
  }

  .stat-divider {
    width: 1px;
    height: 2rem;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 480px) {
    .card-body {
      padding: 1.75rem 1.25rem;
    }
    .card-stat-col {
      flex-direction: row;
      padding: 1.5rem 1.25rem;
      gap: 1.5rem;
    }
    .stat-divider {
      width: 2rem;
      height: 1px;
    }
  }
</style>
