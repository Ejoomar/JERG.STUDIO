---
const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    title: "Tu tienda propia",
    desc: "Deja de depender solo de ML. Construimos tu tienda online con tu marca, donde cobras sin comisiones y los clientes son tuyos.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><path d="M8 10h8M8 14h5"/></svg>`,
    title: "Catálogo con WhatsApp",
    desc: "Un catálogo digital en tu dominio donde tus clientes ven tus productos y te escriben directo al WhatsApp — sin pasar por ML.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    title: "Sincronización de inventario",
    desc: "Tu stock siempre actualizado en ML y en tu tienda al mismo tiempo. Vendés en los dos lados sin riesgo de quedarte sin stock.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
    title: "Automatizaciones ML",
    desc: "Respuestas automáticas a preguntas frecuentes, actualización masiva de precios y seguimiento de pedidos — todo sin intervención manual.",
  },
];
---

<section id="ml-section" class="ml-wrapper" aria-labelledby="ml-heading">

  <!-- Fondo decorativo -->
  <div class="ml-bg-glow" aria-hidden="true"></div>

  <div class="ml-container">

    <!-- Header -->
    <div class="ml-header fade-up">
      <!-- Badge ML -->
      <div class="ml-badge">
        <svg width="18" height="18" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <ellipse cx="24" cy="24" rx="22" ry="22" fill="#FFE600"/>
          <path d="M12 30V20l6 7 6-7v10M30 30V20l4 5 4-5v10" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Para vendedores de MercadoLibre</span>
      </div>

      <h2 id="ml-heading" class="ml-title">
        ¿Vendes en MercadoLibre?<br/>
        <em class="ml-accent">Esto te va a interesar.</em>
      </h2>

      <p class="ml-subtitle">
        ML te da visibilidad, pero los clientes son de ellos. Nosotros te ayudamos a construir
        lo que es tuyo: tu tienda, tu marca, tu base de clientes.
      </p>
    </div>

    <!-- Cards -->
    <div class="ml-grid fade-up">
      {services.map(({ icon, title, desc }) => (
        <div class="ml-card">
          <div class="ml-card-icon" set:html={icon} aria-hidden="true" />
          <h3 class="ml-card-title">{title}</h3>
          <p class="ml-card-desc">{desc}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="ml-cta-row fade-up">
      <p class="ml-cta-note">
        Precio fijo desde el día uno. Sin cobros por hora, sin sorpresas al final.
      </p>
      <div class="ml-btn-group">
        <a
          href="https://wa.me/56967657198?text=Hola%2C%20vendo%20en%20MercadoLibre%20y%20quiero%20hablar%20sobre%20mis%20opciones"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-cta-btn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Hablar sobre mi negocio en ML
        </a>
        <a href="/mercadolibre" class="ml-cta-ghost">
          Ver todo lo que ofrecemos
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Wrapper ── */
  .ml-wrapper {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 5rem 1.5rem;
    background: #070707;
  }

  /* ── Glow decorativo amarillo ── */
  .ml-bg-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 480px;
    background: radial-gradient(ellipse, rgba(255,230,0,0.13) 0%, transparent 68%);
    pointer-events: none;
  }

  /* ── Container ── */
  .ml-container {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
  }

  /* ── Header ── */
  .ml-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    max-width: 48rem;
  }

  .ml-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 230, 0, 0.1);
    border: 1px solid rgba(255, 230, 0, 0.35);
    border-radius: 999px;
    padding: 0.35rem 1rem 0.35rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #FFE600;
    text-transform: uppercase;
  }

  .ml-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f5f0e8;
  }

  .ml-accent {
    font-style: italic;
    color: #FFE600;
  }

  .ml-subtitle {
    font-size: clamp(0.9rem, 1.2vw + 0.2rem, 1.05rem);
    color: rgba(245, 240, 232, 0.45);
    line-height: 1.7;
    max-width: 38rem;
  }

  /* ── Grid de cards ── */
  .ml-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    width: 100%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 1rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ml-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .ml-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Card ── */
  .ml-card {
    background: #0a0a0a;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: background 0.25s;
  }

  .ml-card:hover {
    background: rgba(255, 230, 0, 0.07);
  }

  .ml-card-icon {
    color: #FFE600;
    opacity: 1;
    width: fit-content;
    transition: opacity 0.2s, transform 0.3s;
  }

  .ml-card:hover .ml-card-icon {
    opacity: 1;
    transform: translateY(-2px);
  }

  .ml-card-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #f5f0e8;
    line-height: 1.2;
  }

  .ml-card-desc {
    font-size: 0.85rem;
    color: rgba(245, 240, 232, 0.48);
    line-height: 1.65;
    flex: 1;
  }

  /* ── CTA row ── */
  .ml-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .ml-cta-note {
    font-size: 0.82rem;
    color: rgba(245, 240, 232, 0.3);
  }

  .ml-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFE600;
    color: #111;
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.95rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 32px rgba(255, 230, 0, 0.45);
  }

  .ml-cta-btn:hover {
    background: #fff176;
    transform: translateY(-2px);
    box-shadow: 0 10px 44px rgba(255, 230, 0, 0.6);
    color: #111;
  }

  /* ── Botones en fila ── */
  .ml-btn-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ml-cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(255, 230, 0, 0.3);
    color: #FFE600;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.82rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    background: rgba(255, 230, 0, 0.05);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .ml-cta-ghost:hover {
    background: rgba(255, 230, 0, 0.1);
    border-color: rgba(255, 230, 0, 0.55);
    transform: translateY(-2px);
    color: #FFE600;
  }
  .ml-cta-ghost svg {
    transition: transform 0.25s ease;
  }
  .ml-cta-ghost:hover svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ml-card, .ml-cta-btn, .ml-cta-ghost, .ml-card-icon { transition: none; }
  }
</style>
