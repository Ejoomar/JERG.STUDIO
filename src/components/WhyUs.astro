---
const reasons = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "Entrega rápida",
    value: "2–4 semanas",
    desc: "Proyectos listos en tiempo récord sin sacrificar calidad. Metodología ágil con iteraciones semanales.",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: "Sin letras pequeñas",
    value: "Precio fijo",
    desc: "Cotización clara desde el primer día. Sin costos ocultos, sin sorpresas al final del proyecto.",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    title: "Resultados medibles",
    value: "SEO + Velocidad",
    desc: "SEO técnico, Core Web Vitals y optimización de conversión incluidos en cada entrega.",
  },
];
---

<section class="section whyus" aria-labelledby="whyus-heading">
  <div class="whyus-inner">
    <div class="whyus-header fade-up">
      <span class="section-label">Por qué elegirnos</span>
      <h2 id="whyus-heading" class="section-title">
        Hacemos lo que prometemos,<br/>
        <span class="gradient-text">siempre</span>
      </h2>
    </div>

    <div class="whyus-grid">
      {reasons.map((r, i) => (
        <div class={`whyus-card fade-up delay-${i + 1}`}>
          <div class="whyus-icon" aria-hidden="true" set:html={r.icon} />
          <div class="whyus-value">{r.value}</div>
          <h3 class="whyus-title">{r.title}</h3>
          <p class="whyus-desc">{r.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .whyus {
    background: var(--color-background-offset);
    position: relative;
    overflow: hidden;
  }

  .whyus::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gradient-hero);
    opacity: 0.3;
  }

  .whyus-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .whyus-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .whyus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .whyus-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 2.5rem 2rem;
    background: rgba(13,13,13,0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    position: relative;
    overflow: hidden;
    transition: border-color var(--duration-normal), transform var(--duration-normal);
  }
  .whyus-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .whyus-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-hero);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .whyus-card:hover::after { transform: scaleX(1); }

  .whyus-icon {
    color: var(--color-primary);
  }

  .whyus-value {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.4rem, 2vw + 0.5rem, 2rem);
    font-weight: 800;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .whyus-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .whyus-desc {
    font-size: 0.92rem;
    color: var(--color-text-offset);
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .whyus-grid { grid-template-columns: 1fr; max-width: 560px; }
  }

  @media (max-width: 640px) {
    .whyus-card { padding: 1.75rem 1.5rem; }
  }
</style>
