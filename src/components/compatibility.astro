---
import CompatibilityList from "~/components/compatibility-list.astro";
import ContentSection from "~/components/content-section.astro";
import type { CompatibilityItem } from "~/types";

const frontend: Array<CompatibilityItem> = [
  { title: "React",   icon: "frameworks/react",  url: "https://react.dev" },
  { title: "Vue",     icon: "frameworks/vue",    url: "https://vuejs.org" },
  { title: "Svelte",  icon: "frameworks/svelte", url: "https://svelte.dev" },
  { title: "Solid",   icon: "frameworks/solid",  url: "https://solidjs.com" },
  { title: "Preact",  icon: "frameworks/preact", url: "https://preactjs.com" },
  { title: "Lit",     icon: "frameworks/lit",    url: "https://lit.dev" },
];

const backend: Array<CompatibilityItem> = [
  { title: "Vercel",      icon: "platforms/vercel",     url: "https://vercel.com" },
  { title: "Netlify",     icon: "platforms/netlify",    url: "https://netlify.com" },
  { title: "Render",      icon: "platforms/render",     url: "https://render.com" },
  { title: "Cloudflare",  icon: "fa-brands:cloudflare", url: "https://cloudflare.com" },
  { title: "GitHub",      icon: "fa-brands:github",     url: "https://github.com" },
  { title: "Docker",      icon: "fa-brands:docker",     url: "https://docker.com" },
];
---

<ContentSection title="Tecnologías" id="compatibility">
  <Fragment slot="eyebrow">
    <span class="eyebrow">Nuestro stack</span>
  </Fragment>
  <Fragment slot="lead">
    Trabajamos con las herramientas
    <span class="text-primary">más modernas</span> y probadas
    para garantizar <span class="text-primary">calidad y velocidad</span>.
  </Fragment>
  <CompatibilityList items={frontend} title="Frameworks" url="https://react.dev" />
  <CompatibilityList items={backend}  title="Deploy & Infra" url="https://vercel.com" />
</ContentSection>
