---
export interface Props {
  id: string;
  title: string;
}

const { title, id } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-24 px-6 py-16 md:py-20"
>
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 space-y-8">
    <!-- Eyebrow + headline -->
    <div class="flex flex-col items-center gap-4 text-center">
      <slot name="eyebrow" />
      <h2
        class="gradient-text text-center font-display font-extrabold tracking-tight"
        style="font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1.0; letter-spacing: -0.02em;"
      >
        {title}
      </h2>
    </div>

    <!-- Lead copy -->
    <p class="max-w-2xl text-center text-offset leading-relaxed" style="font-size: clamp(0.95rem, 1.2vw + 0.3rem, 1.15rem); line-height: 1.7;">
      <slot name="lead" />
    </p>

    <!-- Content slot -->
    <slot />
  </div>
</section>
