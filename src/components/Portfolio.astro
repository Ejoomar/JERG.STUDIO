---
const projects = [
  {
    image: "https://placehold.co/600x400/111827/6366f1?text=RestaurantePro",
    title: "RestaurantePro",
    category: "Sistema a Medida",
    result: "↑ 300% en pedidos online",
    tech: ["React", "Node.js", "PostgreSQL"],
    description: "Sistema de gestión de pedidos y reservas para cadena de restaurantes.",
  },
  {
    image: "https://placehold.co/600x400/111827/22d3ee?text=ModaFusion",
    title: "ModaFusión",
    category: "E-commerce",
    result: "↑ 180% en ventas",
    tech: ["Astro", "Stripe", "Cloudflare"],
    description: "Tienda online de moda con catálogo de +2000 productos y pasarela de pagos.",
  },
  {
    image: "https://placehold.co/600x400/111827/8b5cf6?text=ConstructTrack",
    title: "ConstructTrack",
    category: "App Web",
    result: "↓ 60% tiempo de reportes",
    tech: ["Vue.js", "Laravel", "MySQL"],
    description: "Dashboard de seguimiento de obras en tiempo real para constructora regional.",
  },
  {
    image: "https://placehold.co/600x400/111827/10b981?text=SaludNet",
    title: "SaludNet",
    category: "Landing + CRM",
    result: "+400 leads/mes",
    tech: ["Next.js", "Supabase", "n8n"],
    description: "Landing page y CRM integrado para clínica médica privada.",
  },
];
---

<section id="portfolio" class="section portfolio" aria-labelledby="portfolio-heading">
  <div class="portfolio-inner">
    <div class="portfolio-header fade-up">
      <span class="section-label">Portfolio</span>
      <h2 id="portfolio-heading" class="section-title">
        Proyectos que generan<br/>
        <span class="gradient-text">resultados reales</span>
      </h2>
      <p class="section-subtitle">
        Cada proyecto es una colaboración única. Aquí algunos de los que nos enorgullecen.
      </p>
    </div>

    <div class="portfolio-grid">
      {projects.map((p, i) => (
        <article class={`project-card fade-up delay-${(i % 2) + 1}`}>
          <div class="project-image">
            <img
              src={p.image}
              alt={`Captura del proyecto ${p.title}`}
              width="600"
              height="400"
              loading="lazy"
            />
            <div class="project-overlay">
              <span class="project-category">{p.category}</span>
            </div>
          </div>
          <div class="project-body">
            <div class="project-meta">
              <h3 class="project-title">{p.title}</h3>
              <span class="project-result">{p.result}</span>
            </div>
            <p class="project-desc">{p.description}</p>
            <div class="project-tech">
              {p.tech.map(t => (
                <span class="tech-badge">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .portfolio {
    background: var(--color-background-offset);
    position: relative;
  }

  .portfolio::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--gradient-hero);
    opacity: 0.15;
  }

  .portfolio-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .portfolio-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--duration-normal), transform var(--duration-normal), box-shadow var(--duration-normal);
  }
  .project-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow);
  }

  .project-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .project-card:hover .project-image img {
    transform: scale(1.04);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .project-category {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    background: rgba(13,13,13,0.7);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .project-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .project-result {
    font-size: 0.82rem;
    font-weight: 700;
    color: #22d3ee;
    background: rgba(34,211,238,0.1);
    border: 1px solid rgba(34,211,238,0.2);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--color-text-offset);
    line-height: 1.6;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .tech-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-offset);
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .project-card:hover .tech-badge {
    border-color: rgba(99,102,241,0.3);
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .portfolio-grid { grid-template-columns: 1fr; }
  }
</style>
