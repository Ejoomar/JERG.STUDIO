---
const services = [
  {
    num: "01",
    title: "Páginas Web",
    description: "Diseño que convierte. Landing pages, sitios corporativos y portales construidos para posicionar, captar y retener. Optimizados para Core Web Vitals y SEO desde el día uno.",
    meta: ["Landing pages", "Sitios corporativos", "SEO técnico"],
    tag: "Web",
    accent: "#6366f1",
  },
  {
    num: "02",
    title: "Sistemas a Medida",
    description: "CRM, inventarios, dashboards, facturación. Sistemas que encajan en tu flujo de trabajo — no al revés. Análisis, diseño y desarrollo completo con soporte continuo.",
    meta: ["CRM", "ERP ligero", "Dashboards"],
    tag: "Software",
    accent: "#22d3ee",
  },
  {
    num: "03",
    title: "E-commerce",
    description: "Tiendas online con pasarela de pago integrada, catálogo dinámico y gestión de pedidos en tiempo real. Escalables desde 10 hasta 10 000 productos.",
    meta: ["Stripe / PayPal", "Gestión de stock", "Análisis de ventas"],
    tag: "Tienda",
    accent: "#8b5cf6",
  },
  {
    num: "04",
    title: "Apps Web y Móvil",
    description: "Aplicaciones multiplataforma rápidas y escalables — para tu equipo interno o tus clientes finales. PWA, React Native o Expo según lo que requiera el proyecto.",
    meta: ["PWA", "iOS & Android", "Offline-first"],
    tag: "Apps",
    accent: "#f59e0b",
  },
  {
    num: "05",
    title: "Automatizaciones",
    description: "Bots, integraciones y flujos que eliminan trabajo repetitivo. Cada hora ahorrada es margen ganado. Conectamos tus herramientas: CRM, WhatsApp, email, contabilidad.",
    meta: ["n8n / Zapier", "WhatsApp API", "Integraciones"],
    tag: "Bots",
    accent: "#10b981",
  },
  {
    num: "06",
    title: "Soporte Continuo",
    description: "El primer mes de soporte es completamente gratis — sin letra pequeña. Después, si quieres que sigamos encargándonos de todo, tienes la opción de un plan mensual por $40 USD: actualizaciones, mejoras, backups y cualquier ajuste que necesites. Sin contrato, sin presión.",
    meta: ["1 mes gratis", "Desde $40 / mes", "Sin permanencia"],
    tag: "Soporte",
    accent: "#ef4444",
  },
];
---

<section id="features" class="scroll-mt-24 px-6 py-16 md:py-20 flex flex-col items-center">

  <!-- Cabecera editorial -->
  <div class="w-full max-w-6xl mb-16 md:mb-20">
    <div class="flex flex-col gap-6">
      <span class="eyebrow tracking-[0.22em]">Capacidades</span>
      <h2
        class="uppercase"
        style="font-family:'DM Serif Display',Georgia,serif;font-size:clamp(2.8rem,7vw,6rem);line-height:0.95;letter-spacing:-0.025em;font-weight:400;color:var(--color-text);"
        data-split
      >
        Seis disciplinas.<br/>
        <em class="accent-italic">Un propósito.</em>
      </h2>
      <p
        class="max-w-lg"
        style="font-size:clamp(0.9rem,1.2vw + 0.3rem,1.1rem);line-height:1.7;letter-spacing:0.02em;color:var(--color-text-offset);"
      >
        Convertir tu visión en resultados medibles. Sin rodeos, sin relleno.<br/>Solo trabajo que se puede medir.
      </p>
    </div>
  </div>

  <!-- Lista -->
  <div class="feat-list w-full max-w-6xl" id="features-list">
    {services.map(({ num, title, description, meta, tag, accent }) => (
      <div class="feat-item js-feat-item" style={`--accent:${accent};`}>

        <!-- Glow de fondo — patrón hero-glow del proyecto -->
        <div class="feat-glow" aria-hidden="true"></div>

        <!-- Fila clickeable -->
        <button class="feat-row" aria-expanded="false" type="button">

          <!-- Número en DM Serif italic grande — F2 sin label -->
          <div class="feat-num-col" aria-hidden="true">
            <span class="feat-num">{num}</span>
          </div>

          <!-- Título -->
          <span class="feat-title">{title}</span>

          <!-- Tag — patrón eyebrow con líneas flanqueantes -->
          <span class="feat-tag" style={`color:${accent};`}>{tag}</span>

          <!-- Toggle -->
          <span class="feat-icon" aria-hidden="true">
            <svg class="feat-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            <svg class="feat-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/></svg>
          </span>
        </button>

        <!-- Panel expandible -->
        <div class="feat-panel" role="region">
          <div class="feat-panel-inner">
            <p class="feat-desc">{description}</p>
            <div class="feat-meta">
              {meta.map(m => (
                <span class="feat-chip" style={`color:${accent};border-color:${accent}38;background:${accent}0d;`}>{m}</span>
              ))}
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  /* ── Lista ── */
  .feat-list {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  /* ── Ítem ── */
  .feat-item {
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    overflow: hidden;
  }

  /* Glow — hero-glow del proyecto */
  .feat-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 65% 130% at 20% 50%,
      rgba(16,185,129,0.09) 0%,
      transparent 68%
    );
    opacity: 0;
    transition: opacity 0.42s cubic-bezier(0.16,1,0.3,1);
  }
  .feat-item.is-open .feat-glow { opacity: 1; }

  /* ── Fila ── */
  .feat-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    padding: 1.1rem 0;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    text-align: left;
  }

  /* ── Columna de número — F2 sin label ── */
  .feat-num-col {
    flex-shrink: 0;
    width: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 0.35rem;
  }

  .feat-num {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-text-offset);
    opacity: 0.35;
    transition: color 0.42s cubic-bezier(0.16,1,0.3,1), opacity 0.42s;
    user-select: none;
  }
  .feat-item.is-open .feat-num {
    color: rgba(16,185,129,0.7);
    opacity: 1;
  }

  /* ── Título ── */
  .feat-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.2rem, 2.8vw, 2rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.025em;
    line-height: 0.95;
    color: var(--color-text);
    opacity: 0.82;
    flex: 1;
    text-align: left;
    transition: opacity 0.2s;
  }
  .feat-item.is-open .feat-title { opacity: 1; }
  .feat-row:hover .feat-title    { opacity: 0.95; }

  /* ── Tag — eyebrow con líneas flanqueantes ── */
  .feat-tag {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    flex-shrink: 0;
    transition: opacity 0.3s;
  }
  .feat-tag::before,
  .feat-tag::after {
    content: '';
    display: block;
    width: 14px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .feat-item.is-open .feat-tag { opacity: 0.7; }

  @media (min-width: 480px) {
    .feat-tag { display: inline-flex; }
  }

  /* ── Ícono toggle ── */
  .feat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-text-offset);
    flex-shrink: 0;
    transition: border-color 0.2s, color 0.2s,
                transform 0.42s cubic-bezier(0.16,1,0.3,1);
  }
  .feat-item.is-open .feat-icon {
    border-color: var(--accent);
    color: var(--accent);
    transform: rotate(45deg);
  }

  .feat-plus  { display: block; }
  .feat-minus { display: none; }
  .feat-item.is-open .feat-plus  { display: none; }
  .feat-item.is-open .feat-minus { display: block; }

  /* ── Panel expandible — grid-template-rows ── */
  .feat-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.16,1,0.3,1);
    position: relative;
    z-index: 1;
  }
  .feat-item.is-open .feat-panel {
    grid-template-rows: 1fr;
  }

  .feat-panel-inner {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 0 0 0;
  }

  /* Contenido del panel — alineado con el título */
  .feat-desc {
    padding: 0.1rem 0 0 calc(5.5rem + 1.5rem);
    font-size: clamp(0.82rem, 1.1vw + 0.2rem, 0.95rem);
    line-height: 1.78;
    color: var(--color-text-offset);
    max-width: 38rem;
  }

  .feat-meta {
    padding: 0 0 1.5rem calc(5.5rem + 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .feat-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.17rem 0.6rem;
    border-radius: 999px;
    border-width: 1px;
    border-style: solid;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .feat-num-col { width: 4rem; }
    .feat-num { font-size: clamp(1.5rem, 6vw, 2.2rem); }
    .feat-desc,
    .feat-meta { padding-left: calc(4rem + 1.5rem); }
  }

  @media (max-width: 400px) {
    .feat-row { gap: 1rem; }
    .feat-num-col { width: 3rem; padding-right: 0.2rem; }
    .feat-num { font-size: 1.5rem; }
    .feat-desc,
    .feat-meta { padding-left: calc(3rem + 1rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-panel,
    .feat-glow,
    .feat-num,
    .feat-icon { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('.feat-item').forEach(item => {
    const btn = item.querySelector('.feat-row') as HTMLButtonElement;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Cerrar todos
      document.querySelectorAll('.feat-item').forEach(other => {
        (other.querySelector('.feat-row') as HTMLButtonElement)
          .setAttribute('aria-expanded', 'false');
        other.classList.remove('is-open');
      });

      // Abrir el clickeado si estaba cerrado
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        item.classList.add('is-open');
      }
    });
  });
</script>
