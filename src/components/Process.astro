---
const steps = [
  {
    num: "01",
    phase: "Descubrimiento",
    title: "Nos cuentas tu idea",
    desc: "Cuéntanos qué necesitas por WhatsApp o email. Analizamos tu proyecto y te decimos con claridad si podemos ayudarte.",
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      <path d="M8 10h8M8 14h5"/>
    </svg>`,
  },
  {
    num: "02",
    phase: "Propuesta",
    title: "Acordamos todo por escrito",
    desc: "Diseño, tecnología y precio fijo en 48 h. Revisamos juntos hasta que estés 100% conforme. Sin letra pequeña.",
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <polyline points="9 15 11 17 15 12"/>
    </svg>`,
  },
  {
    num: "03",
    phase: "Desarrollo",
    title: "Lo construimos juntos",
    desc: "Cada semana ves cómo avanza tu proyecto. Nos dices qué cambiar, lo ajustamos y seguimos. Sin sustos al final.",
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="16 18 22 12 16 6"/>
      <polyline points="8 6 2 12 8 18"/>
      <line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 3"/>
    </svg>`,
  },
  {
    num: "04",
    phase: "Entrega",
    title: "Sale al mundo",
    desc: "Tu proyecto queda en vivo. Te enseñamos a manejarlo y nos quedamos contigo el primer mes sin costo extra.",
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
      <path d="M2 12h20"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>`,
  },
];
---

<section id="process" class="process-section" aria-labelledby="process-heading">

  <!-- Cabecera -->
  <div class="process-header border-b border-default fade-up">
    <div class="mx-auto max-w-6xl px-8 py-10 flex flex-col items-center gap-4 text-center">
      <span class="eyebrow tracking-[0.22em]">Método</span>
      <h2
        id="process-heading"
        class="tracking-tight"
        class="process-heading"
        style="font-family:'DM Serif Display',Georgia,serif;font-size:clamp(3rem,7vw,5.5rem);font-weight:400;"
      >
        <em class="accent-italic">El Proceso</em>
      </h2>
      <p class="max-w-lg text-offset" style="font-size:1.1rem;line-height:1.7;">
        Así trabajamos con cada cliente,<br/>
        <span class="text-default font-semibold">desde la primera conversación hasta el lanzamiento.</span>
      </p>
    </div>
  </div>

  <!-- Grid de pasos -->
  <div id="process-track">
    {steps.map(({ num, phase, title, desc, icon }, i) => (
      <div class={`process-step fade-up delay-${i + 1}`} data-step={num}>

        <!-- Número ghost de fondo -->
        <span class="step-bg-num" aria-hidden="true">{num}</span>

        <!-- Contenido -->
        <div class="step-inner">

          <!-- Ícono + fase -->
          <div class="step-top">
            <span class="step-icon" aria-hidden="true" set:html={icon} />
            <span class="step-phase">{phase}</span>
          </div>

          <h3 class="step-title">{title}</h3>
          <p class="step-desc">{desc}</p>
        </div>

      </div>
    ))}
  </div>

  <!-- Indicador de swipe — solo móvil -->
  <div class="swipe-hint" aria-hidden="true">
    <span class="swipe-dot active"></span>
    <span class="swipe-dot"></span>
    <span class="swipe-dot"></span>
    <span class="swipe-dot"></span>
  </div>

  <!-- Footer CTA -->
  <div class="process-footer border-t border-default fade-up">
    <div class="mx-auto max-w-6xl px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-offset">
        ¿Tienes un proyecto en mente? Escríbenos y hablamos.
      </p>
      <a href="#contact" class="btn-primary btn-magnetic shrink-0">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.007 1.17 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.92a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        Empezar ahora
      </a>
    </div>
  </div>

</section>

<style>
  .process-section {
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  /* ── Track — carrusel en móvil, grid en tablet/desktop ── */
  #process-track {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px)  { #process-track { grid-template-columns: repeat(2,1fr); } }
  @media (min-width: 1280px) { #process-track { grid-template-columns: repeat(4,1fr); } }

  /* Carrusel horizontal en móvil */
  @media (max-width: 767px) {
    #process-track {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 0;
      padding-bottom: 0.5rem;
    }
    #process-track::-webkit-scrollbar { display: none; }
  }

  /* ── Paso ── */
  .process-step {
    position: relative;
    overflow: hidden;
    padding: 2rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: flex-start;
    transition: background 0.25s;
  }
  .process-step:hover { background: rgba(16,185,129,0.022); }

  /* Paso como slide en móvil */
  @media (max-width: 767px) {
    .process-step {
      flex: 0 0 82vw;
      scroll-snap-align: start;
      min-height: 320px;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
      padding: 2rem 1.5rem;
    }
    .process-step:last-child { border-right: none; }
  }

  @media (min-width: 768px) {
    .process-step {
      min-height: 340px; padding: 2.5rem 2rem;
      border-right: 1px solid var(--color-border);
    }
    .process-step:nth-child(2n) { border-right: none; }
    .process-step:nth-child(3),
    .process-step:nth-child(4) { border-bottom: none; }
  }
  @media (min-width: 1280px) {
    .process-step {
      min-height: 400px; padding: 3rem 2.5rem;
      border-right: 1px solid var(--color-border);
      border-bottom: none;
    }
    .process-step:nth-child(2n) { border-right: 1px solid var(--color-border); }
    .process-step:last-child     { border-right: none; }
  }

  /* ── Indicador de swipe (dots) ── */
  .swipe-hint {
    display: none;
  }
  @media (max-width: 767px) {
    .swipe-hint {
      display: flex;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.75rem 0 0.25rem;
    }
    .swipe-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-border);
      transition: background 0.2s, transform 0.2s;
    }
    .swipe-dot.active {
      background: #10b981;
      transform: scale(1.3);
    }
  }

  /* Línea de acento inferior */
  .process-step::after {
    content: '';
    position: absolute; bottom:0; left:0; right:0; height:2px;
    background: linear-gradient(90deg, #10b981, transparent 70%);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .process-step:hover::after { transform: scaleX(1); }

  /* ── Número ghost ── */
  .step-bg-num {
    position: absolute; right:-0.5rem; bottom:-1rem;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(6rem,10vw,9rem);
    font-weight: 400; line-height:1; letter-spacing:-0.06em;
    color: rgba(16,185,129,0.22);
    pointer-events:none; user-select:none;
    transition: color 0.4s;
  }
  .process-step:hover .step-bg-num { color: rgba(16,185,129,0.42); }

  :global([data-theme="light"]) .step-bg-num {
    color: rgba(5,150,105,0.18);
  }
  :global([data-theme="light"]) .process-step:hover .step-bg-num {
    color: rgba(5,150,105,0.32);
  }

  /* ── Inner ── */
  .step-inner {
    position: relative; z-index:1;
    display: flex; flex-direction:column; gap:1.1rem; width:100%;
  }

  /* ── Ícono + fase ── */
  .step-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #10b981;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), opacity 0.2s;
  }
  .process-step:hover .step-icon { transform: scale(1.08); }

  /* Etiqueta de fase — resaltada */
  .step-phase {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #10b981;
    background: rgba(16,185,129,0.1);
    border: 1px solid rgba(16,185,129,0.25);
    padding: 0.22rem 0.7rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  /* ── Título ── */
  .step-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.5rem,3vw,2.4rem);
    font-weight: 400; font-style:italic;
    line-height: 1.05; letter-spacing:-0.025em;
    color: rgba(245,240,232,0.88);
    transition: color 0.2s;
  }
  .process-step:hover .step-title { color: #f5f0e8; }

  /* ── Heading principal ── */
  .process-heading { color: #f5f0e8; }

  /* ── Light mode overrides ── */
  :global([data-theme="light"]) .process-heading { color: #0a0a0a; }
  :global([data-theme="light"]) .step-title { color: rgba(10,10,10,0.85); }
  :global([data-theme="light"]) .process-step:hover .step-title { color: #050505; }

  /* ── Descripción ── */
  .step-desc {
    font-size: clamp(0.88rem,1.2vw,1rem);
    color: var(--color-text-offset);
    line-height: 1.75; max-width:28rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step, .step-bg-num, .step-icon { transition: none; }
    .process-step::after { display: none; }
  }
</style>

<script>
  // Sincronizar dots con el carrusel en móvil
  const track = document.getElementById('process-track');
  const dots  = document.querySelectorAll('.swipe-dot');
  if (track && dots.length) {
    track.addEventListener('scroll', () => {
      const stepWidth = track.firstElementChild?.clientWidth ?? 1;
      const idx = Math.round(track.scrollLeft / stepWidth);
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    }, { passive: true });
  }
</script>
