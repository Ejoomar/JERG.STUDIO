---
// Sección editorial — filosofía de agencia al estilo sidewave
const metrics = [
  {
    value: "2–4",
    unit: "sem.",
    count: null,
    label: "Entrega rápida",
    desc: "Del concepto al deploy en tiempo récord con iteraciones semanales.",
  },
  {
    value: "100",
    unit: "%",
    count: 100,
    label: "Precio fijo",
    desc: "Cotización cerrada antes de empezar. Sin costos adicionales.",
  },
  {
    value: "98",
    unit: "%",
    count: 98,
    label: "Satisfacción",
    desc: "La mayoría vuelve con el siguiente proyecto o nos recomienda.",
  },
];
---

<section
  id="intro"
  class="scroll-mt-24 border-y border-default overflow-hidden"
  aria-labelledby="intro-heading"
>
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px]">

      <!-- Columna izquierda: declaración filosófica -->
      <div class="intro-left flex flex-col justify-center gap-8 px-8 py-16 lg:px-16 fade-up">
        <span class="eyebrow tracking-[0.22em]">Filosofía</span>

        <h2
          id="intro-heading"
          class="font-display font-extrabold leading-[1.06]"
          style="font-size: clamp(2rem, 4.5vw + 0.5rem, 3.6rem);"
          data-split
        >
          No vendemos proyectos.<br/>
          <span class="gradient-text">Construimos</span> resultados.
        </h2>

        <p class="max-w-md text-offset leading-relaxed" style="font-size: 1.05rem; line-height: 1.75;">
          Precio fijo desde el día uno. Iteraciones semanales con preview en vivo.
          Entregamos lo que acordamos, cuando lo acordamos.
          Sin letra pequeña. Sin excusas.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href="https://wa.me/56967657198?text=Hola%2C%20quiero%20hablar%20sobre%20mi%20proyecto"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary btn-magnetic"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Hablemos 15 min
          </a>
          <a href="#features" class="btn-ghost">Ver capacidades</a>
        </div>

        <!-- Tech stack badges -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {["Astro", "React", "Next.js", "Supabase", "Vercel"].map(t => (
            <span class="rounded-full border border-default px-3 py-1 text-xs font-semibold text-offset tracking-wide">
              {t}
            </span>
          ))}
        </div>
      </div>

      <!-- Columna derecha: métricas -->
      <div class="intro-metrics divide-y divide-default border-t border-default lg:border-t-0 lg:border-l lg:border-default fade-up delay-2">
        {metrics.map(({ value, unit, count, label, desc }) => (
          <div class="metric-card group flex flex-col gap-2 p-8 transition-colors duration-200 hover:bg-primary/5 cursor-default">
            <div class="flex items-baseline gap-1">
              <span
                class="gradient-text font-display font-extrabold leading-none"
                style="font-size: 3.25rem;"
                data-count={count ?? undefined}
              >
                {value}
              </span>
              <span class="font-display font-bold text-primary" style="font-size: 1.4rem;">{unit}</span>
            </div>
            <p class="font-extrabold text-sm uppercase tracking-widest">{label}</p>
            <p class="text-xs text-offset leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .intro-left {
    position: relative;
  }
  .intro-left::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #6366f1, #22d3ee);
  }

  .metric-card {
    position: relative;
  }
  .metric-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, #6366f1, #22d3ee);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .metric-card:hover::before {
    opacity: 1;
  }
</style>
