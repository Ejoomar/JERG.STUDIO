---
// Sección editorial — filosofía de agencia al estilo sidewave
const metrics = [
  {
    value: "2–4",
    unit: "sem.",
    count: null,
    label: "Entrega rápida",
    desc: "Del concepto al deploy en tiempo récord con iteraciones semanales.",
  },
  {
    value: "100",
    unit: "%",
    count: 100,
    label: "Precio fijo",
    desc: "Cotización cerrada antes de empezar. Sin costos adicionales.",
  },
  {
    value: "30",
    unit: " días",
    count: 30,
    label: "Soporte incluido",
    desc: "Post-lanzamiento sin costo extra. Sin contratos, sin letra pequeña.",
  },
];
---

<section
  id="intro"
  class="scroll-mt-24 border-y border-default overflow-hidden"
  aria-labelledby="intro-heading"
>
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px]">

      <!-- Columna izquierda: declaración filosófica -->
      <div class="intro-left js-intro-left flex flex-col justify-center gap-8 px-8 py-12 lg:px-16">
        <span class="eyebrow tracking-[0.22em]">Filosofía</span>

        <h2
          id="intro-heading"
          class="leading-[1.06]"
          style="font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(2rem, 4.5vw + 0.5rem, 3.6rem); font-weight: 400;"
          data-split
        >
          Lo que acordamos<br/>
          <em class="accent-italic">es lo</em> que entregamos.
        </h2>

        <p class="max-w-md text-offset leading-relaxed" style="font-size: 1.05rem; line-height: 1.75;">
          Precio fijo desde el día uno. Iteraciones semanales con preview en vivo.
          Entregamos lo que acordamos, cuando lo acordamos.
          Sin letra pequeña. Sin excusas.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="#contact" class="btn-primary btn-magnetic">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            Iniciar proyecto
          </a>
          <a href="#features" class="btn-ghost">Ver capacidades</a>
        </div>


      </div>

      <!-- Columna derecha: métricas -->
      <div class="intro-metrics js-intro-metrics divide-y divide-default border-t border-default lg:border-t-0 lg:border-l lg:border-default">
        {metrics.map(({ value, unit, count, label, desc }) => (
          <div class="metric-card group flex flex-col gap-2 p-8 transition-colors duration-200 hover:bg-primary/5 cursor-default">
            <div class="flex items-baseline gap-1">
              <span
                class="gradient-text font-display font-extrabold leading-none"
                style="font-size: 3.25rem;"
                data-count={count ?? undefined}
              >
                {value}
              </span>
              <span class="font-display font-bold text-primary" style="font-size: 1.4rem;">{unit}</span>
            </div>
            <p class="font-extrabold text-sm uppercase tracking-widest">{label}</p>
            <p class="text-xs text-offset leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .intro-left {
    position: relative;
  }
  .intro-left::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  }

  .metric-card {
    position: relative;
  }
  .metric-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-secondary));
    opacity: 0;
    transition: opacity 0.25s;
  }
  .metric-card:hover::before {
    opacity: 1;
  }
</style>
